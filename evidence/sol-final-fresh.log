tasks.register('mixinHotPathConfigGetGate') {
    group = 'verification'
    description = 'Fails if active mixins still call ForgeConfigSpec ConfigValue.get() on hot paths.'
    dependsOn classes
    doLast {
        def mixinRoot = file("${projectDir}/src/main/java/network/vonix/isleofberkperformance/mixin")
        def sourceHits = [] as List
        if (mixinRoot.isDirectory()) {
            mixinRoot.eachFileRecurse(groovy.io.FileType.FILES) { f ->
                if (!f.name.endsWith('.java')) {
                    return
                }
                def text = f.getText('UTF-8')
                // Strip block and line comments before scanning for live call sites.
                def code = text
                        .replaceAll(/(?s)\/\*.*?\*\//, ' ')
                        .replaceAll(/\/\/.*/, ' ')
                if (code =~ /PerformanceConfig\.[A-Za-z0-9_]+\s*\.\s*get\s*\(/) {
                    sourceHits << "${f.toPath().toAbsolutePath().normalize()}: PerformanceConfig.*.get()"
                }
                if (code.contains('ForgeConfigSpec') || code.contains('ConfigValue')) {
                    sourceHits << "${f.toPath().toAbsolutePath().normalize()}: Forge config type reference in code"
                }
            }
        }
        if (!sourceHits.isEmpty()) {
            throw new GradleException("mixinHotPathConfigGetGate SOURCE FAIL:\n  - " + sourceHits.join('\n  - '))
        }

        def classRoot = file("${buildDir}/classes/java/main/network/vonix/isleofberkperformance/mixin")
        def bytecodeHits = [] as List
        if (classRoot.isDirectory()) {
            classRoot.eachFileRecurse(groovy.io.FileType.FILES) { f ->
                if (!f.name.endsWith('.class')) {
                    return
                }
                def latin1 = new String(f.bytes, 'ISO-8859-1')
                if (latin1.contains('ForgeConfigSpec') || latin1.contains('ConfigValue')) {
                    bytecodeHits << "${f.toPath().toAbsolutePath().normalize()}: Forge config type in bytecode"
                }
                if (latin1.contains('PerformanceConfig') && latin1.contains('()Ljava/lang/Object;')) {
                    bytecodeHits << "${f.toPath().toAbsolutePath().normalize()}: possible ConfigValue.get Object return"
                }
            }
        }
        if (!bytecodeHits.isEmpty()) {
            throw new GradleException("mixinHotPathConfigGetGate BYTECODE FAIL:\n  - " + bytecodeHits.join('\n  - '))
        }
        logger.lifecycle('mixinHotPathConfigGetGate: PASS (no ForgeConfigSpec/ConfigValue.get in active mixins)')
    }
}

/**
 * Deterministic read-only extra-field fixture. Does not mutate the release JAR.
 * Builds synthetic Info-ZIP 0x5455 (UT), NTFS 0x000a, and Info-ZIP 0x5855 (UX)
 * payloads and proves canonicalizeReobfZipMetadata / zeroZipTimestampExtra
 * change only selected timestamp bytes. Flags, reserved prefix, UID/GID,
 * other attributes, and trailing/unknown bytes are preserved. Malformed,
 * truncated, zero-length, and short timestamp layouts fail closed.
 */
tasks.register('infoZipUxExtraFixture') {
    group = 'verification'
    description = 'Checks UT/NTFS/UX timestamps are canonicalized while non-timestamp bytes are preserved.'
    doLast {
        runInfoZipUxExtraFixture()
    }
}

static int zipU16(byte[] bytes, int offset) {
    return (bytes[offset] & 0xff) | ((bytes[offset + 1] & 0xff) << 8)
}

static long zipU32(byte[] bytes, int offset) {
    return (bytes[offset] & 0xffL) |
            ((bytes[offset + 1] & 0xffL) << 8) |
            ((bytes[offset + 2] & 0xffL) << 16) |
            ((bytes[offset + 3] & 0xffL) << 24)
}

static void zipW16(byte[] bytes, int offset, int value) {
    bytes[offset] = (byte) (value & 0xff)
    bytes[offset + 1] = (byte) ((value >> 8) & 0xff)
}

static void zipW32(byte[] bytes, int offset, long value) {
    bytes[offset] = (byte) (value & 0xff)
    bytes[offset + 1] = (byte) ((value >> 8) & 0xff)
    bytes[offset + 2] = (byte) ((value >> 16) & 0xff)
    bytes[offset + 3] = (byte) ((value >> 24) & 0xff)
}

static void zeroZipTimestampExtra(byte[] bytes, int offset, int length) {
    int cursor = 0
    while (cursor + 4 <= length) {
        int id = zipU16(bytes, offset + cursor)
        int size = zipU16(bytes, offset + cursor + 2)
        if (cursor + 4 + size > length) {
            if (id == 0x5455) {
                throw new GradleException("canonicalizeReobfJar: truncated Info-ZIP 0x5455 extra field")
            }
            if (id == 0x000a) {
                throw new GradleException("canonicalizeReobfJar: truncated NTFS 0x000a extra field")
            }
            if (id == 0x5855) {
                throw new GradleException("canonicalizeReobfJar: truncated Info-ZIP 0x5855 extra field")
            }
            break
        }
        int payload = offset + cursor + 4
        if (id == 0x5455) {
            // UT extra: flags bits 0x01/0x02/0x04 select mtime/atime/ctime.
            // Zero only selected timestamp bytes; preserve flags and trailing/unknown bytes.
            if (size < 1) {
                throw new GradleException("canonicalizeReobfJar: Info-ZIP 0x5455 extra field missing flags")
            }
            int flags = bytes[payload] & 0xff
            int tsCursor = 1
            [0x01, 0x02, 0x04].each { bit ->
                if ((flags & bit) != 0) {
                    if (tsCursor + 4 > size) {
                        throw new GradleException("canonicalizeReobfJar: truncated Info-ZIP 0x5455 timestamp")
                    }
                    for (int i = 0; i < 4; i++) {
                        bytes[payload + tsCursor + i] = 0
                    }
                    tsCursor += 4
                }
            }
        } else if (id == 0x5855) {
            // Info-ZIP Unix extra (UX): AcTime(4) + ModTime(4) [+ UID(2) + GID(2)].
            // Canonicalize only timestamp bytes; preserve UID/GID and any trailing bytes.
            if (size < 8) {
                throw new GradleException("canonicalizeReobfJar: truncated Info-ZIP 0x5855 timestamp payload")
            }
            for (int i = 0; i < 8; i++) {
                bytes[payload + i] = 0
            }
        } else if (id == 0x000a) {
            // NTFS extra: 4-byte reserved prefix, then tag/size/payload records.
            if (size < 4) {
                throw new GradleException("canonicalizeReobfJar: NTFS 0x000a extra field missing reserved prefix")
            }
            int tagCursor = 4
            while (tagCursor < size) {
                if (tagCursor + 4 > size) {
                    throw new GradleException("canonicalizeReobfJar: malformed NTFS 0x000a attribute header")
                }
                int tag = zipU16(bytes, payload + tagCursor)
                int tagSize = zipU16(bytes, payload + tagCursor + 2)
                if (tagCursor + 4 + tagSize > size) {
                    throw new GradleException("canonicalizeReobfJar: truncated NTFS 0x000a attribute record")
                }
                if (tag == 1) {
                    if (tagSize < 24) {
                        throw new GradleException("canonicalizeReobfJar: NTFS 0x000a tag-1 timestamp payload too short")
                    }
                    for (int i = 0; i < 24; i++) {
                        bytes[payload + tagCursor + 4 + i] = 0
                    }
                }
                tagCursor += 4 + tagSize
            }
        }
        cursor += 4 + size
    }
}

static void canonicalizeReobfZipMetadata(File jarFile) {
    if (!jarFile.isFile()) {
        throw new GradleException("canonicalizeReobfJar: expected reobfuscated JAR missing: ${jarFile}")
    }
    byte[] bytes = jarFile.bytes
    if (bytes.length < 22) {
        throw new GradleException("canonicalizeReobfJar: ${jarFile.name} is too small to be a ZIP")
    }

    int eocd = -1
    int minEocd = Math.max(0, bytes.length - 22 - 0xFFFF)
    for (int i = bytes.length - 22; i >= minEocd; i--) {
        if (zipU32(bytes, i) == 0x06054b50L) {
            eocd = i
            break
        }
    }
    if (eocd < 0) {
        throw new GradleException("canonicalizeReobfJar: ZIP end-of-central-directory not found in ${jarFile.name}")
    }
    int commentLen = zipU16(bytes, eocd + 20)
    if (eocd + 22 + commentLen != bytes.length) {
        throw new GradleException("canonicalizeReobfJar: ZIP64 or trailing data is not supported for ${jarFile.name}")
    }
    if (eocd >= 20 && zipU32(bytes, eocd - 20) == 0x07064b50L) {
        throw new GradleException("canonicalizeReobfJar: ZIP64 locator is not supported for ${jarFile.name}")
    }

    int entryCount = zipU16(bytes, eocd + 10)
    long cdSize = zipU32(bytes, eocd + 12)
    long cdOffset = zipU32(bytes, eocd + 16)
    if (cdOffset + cdSize != eocd) {
        throw new GradleException("canonicalizeReobfJar: central directory bounds are invalid in ${jarFile.name}")
    }

    def before = [] as List
    // DOS 1980-02-01 00:00:00; same fixed date Gradle uses for reproducible JARs.
    int dosTime = 0
    int dosDate = (0 << 9) | (2 << 5) | 1
    int pos = (int) cdOffset
    for (int n = 0; n < entryCount; n++) {
        if (pos + 46 > bytes.length || zipU32(bytes, pos) != 0x02014b50L) {
            throw new GradleException("canonicalizeReobfJar: central directory entry ${n} is invalid")
        }
        int nameLen = zipU16(bytes, pos + 28)
        int extraLen = zipU16(bytes, pos + 30)
        int fileCommentLen = zipU16(bytes, pos + 32)
        long localOffset = zipU32(bytes, pos + 42)
        int local = (int) localOffset
        if (local + 30 > bytes.length || zipU32(bytes, local) != 0x04034b50L) {
            throw new GradleException("canonicalizeReobfJar: local header for entry ${n} is invalid")
        }
        int localNameLen = zipU16(bytes, local + 26)
        int localExtraLen = zipU16(bytes, local + 28)
        String name = new String(bytes, pos + 46, nameLen, 'UTF-8')
        if (localNameLen != nameLen || new String(bytes, local + 30, localNameLen, 'UTF-8') != name) {
            throw new GradleException("canonicalizeReobfJar: local/central name mismatch for ${name}")
        }
        before << [
                name          : name,
                crc           : zipU32(bytes, pos + 16),
                compressed    : zipU32(bytes, pos + 20),
                uncompressed  : zipU32(bytes, pos + 24)
        ]

        zipW16(bytes, pos + 12, dosTime)
        zipW16(bytes, pos + 14, dosDate)
        zeroZipTimestampExtra(bytes, pos + 46 + nameLen, extraLen)

        zipW16(bytes, local + 10, dosTime)
        zipW16(bytes, local + 12, dosDate)
        zeroZipTimestampExtra(bytes, local + 30 + localNameLen, localExtraLen)

        pos += 46 + nameLen + extraLen + fileCommentLen
    }
    if (pos != eocd) {
        throw new GradleException("canonicalizeReobfJar: central directory size mismatch in ${jarFile.name}")
    }

    jarFile.bytes = bytes

    java.util.zip.ZipFile zip = new java.util.zip.ZipFile(jarFile)
    try {
        def after = [] as List
        zip.entries().each { entry ->
            after << [
                    name         : entry.name,
                    crc          : entry.crc & 0xffffffffL,
                    compressed   : entry.compressedSize & 0xffffffffL,
                    uncompressed : entry.size & 0xffffffffL
            ]
            zip.getInputStream(entry).withCloseable { stream ->
                byte[] buf = new byte[8192]
                while (stream.read(buf) != -1) {
                    // Force CRC validation of unchanged entry contents.
                }
            }
        }
        if (after != before) {
            throw new GradleException("canonicalizeReobfJar: entry contents/order changed while rewriting ZIP metadata")
        }
    } finally {
        zip.close()
    }
}

static byte[] concatZipBytes(byte[]... parts) {
    int total = 0
    for (int i = 0; i < parts.length; i++) {
        total += parts[i].length
    }
    byte[] out = new byte[total]
    int pos = 0
    for (int i = 0; i < parts.length; i++) {
        System.arraycopy(parts[i], 0, out, pos, parts[i].length)
        pos += parts[i].length
    }
    return out
}

static byte[] zipExtraBlock(int id, byte[] payload) {
    byte[] block = new byte[4 + payload.length]
    zipW16(block, 0, id)
    zipW16(block, 2, payload.length)
    System.arraycopy(payload, 0, block, 4, payload.length)
    return block
}

static byte[] zipNtfsAttribute(int tag, byte[] attrPayload) {
    byte[] rec = new byte[4 + attrPayload.length]
    zipW16(rec, 0, tag)
    zipW16(rec, 2, attrPayload.length)
    System.arraycopy(attrPayload, 0, rec, 4, attrPayload.length)
    return rec
}

static byte[] fillZipBytes(int length, int startValue) {
    byte[] out = new byte[length]
    for (int i = 0; i < length; i++) {
        out[i] = (byte) ((startValue + i) & 0xff)
    }
    return out
}

static byte[] zipSingleByte(int value) {
    return [(byte) (value & 0xff)] as byte[]
}

static byte[] infoZipUxPayload(byte[] atime, byte[] mtime, byte[] uid, byte[] gid) {
    return concatZipBytes(atime, mtime, uid, gid)
}

static byte[] findZipExtraPayload(byte[] extra, int extraLength, int wantedId) {
    int cursor = 0
    while (cursor + 4 <= extraLength) {
        int id = zipU16(extra, cursor)
        int size = zipU16(extra, cursor + 2)
        if (cursor + 4 + size > extraLength) {
            throw new GradleException("infoZipUxExtraFixture: truncated extra field 0x${Integer.toHexString(id)}")
        }
        if (id == wantedId) {
            byte[] payload = new byte[size]
            System.arraycopy(extra, cursor + 4, payload, 0, size)
            return payload
        }
        cursor += 4 + size
    }
    return null
}

static byte[] sliceZipBytes(byte[] src, int from, int toExclusive) {
    if (src == null || from < 0 || toExclusive < from || toExclusive > src.length) {
        throw new GradleException("infoZipUxExtraFixture: invalid slice ${from}..${toExclusive} of ${src == null ? -1 : src.length}")
    }
    byte[] out = new byte[toExclusive - from]
    System.arraycopy(src, from, out, 0, out.length)
    return out
}

