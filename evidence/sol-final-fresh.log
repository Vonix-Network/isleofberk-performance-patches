    54	     * @param aiMoveSnapshot packed tuple from {@link PerformanceSettings#aiMoveSnapshot()}
    55	     */
    56	    public void beginTick(long aiMoveSnapshot) {
    57	        beginTick(
    58	                PerformanceSettings.aiMoveThrottlingEnabled(aiMoveSnapshot),
    59	                PerformanceSettings.aiMoveIntervalTicks(aiMoveSnapshot)
    60	        );
    61	    }
    62	
    63	    /**
    64	     * Compute the single allow/deny decision for this goal tick.
    65	     *
