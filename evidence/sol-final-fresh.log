     1	package network.vonix.isleofberkperformance.internal;
     2	
     3	/**
     4	 * Per-goal AI movement cadence. One allow/deny decision is computed at {@code tick()} HEAD
     5	 * and reused for every gated call in that goal tick.
     6	 *
     7	 * <p>After {@link #reset()} (WrappedGoal start/stop), the cadence is armed: every tick stays
     8	 * due until the first gated request, so the first eligible request after start runs. That
     9	 * request starts a tick-based cooldown. Later due ticks allow every intended call; skip ticks
    10	 * suppress all of them.
    11	 *
    12	 * <p>Reload rule: the AI enabled/interval tuple is read once per {@link #beginTick(long)} from
    13	 * an atomic snapshot. If the effective enabled flag or sanitized interval changes versus the
    14	 * previous tick, the cadence deterministically rearms so the next eligible request runs
    15	 * immediately and starts cooldown under the new interval. Old cooldown values are never kept
    16	 * across an effective settings change (for example 20→2 or 2→20 mid-cooldown).
    17	 *
    18	 * <p>Skipped {@code moveTo} calls return {@link #SKIPPED_MOVE_TO_RESULT} ({@code true}) so a
    19	 * suppressed refresh is not reported as a pathfinding failure. When a call is allowed, the
    20	 * original boolean is returned unchanged.
    21	 *
    22	 * <p>State is booleans, a cooldown in {@code 0 .. interval-1}, and the last observed settings
    23	 * pair. No entity/world references, no per-tick allocation, and no unbounded counters.
    24	 */
    25	public final class AiMoveCadence {
    26	    /**
    27	     * Value returned in place of {@code PathNavigation.moveTo} when this tick is not due.
    28	     * {@code true} avoids caller failure/fallback branches; it does not mean a new path was set.
    29	     */
    30	    public static final boolean SKIPPED_MOVE_TO_RESULT = true;
    31	
    32	    private boolean armed = true;
    33	    private int cooldownRemaining;
    34	    private boolean allowThisTick;
    35	    private boolean throttlingActive;
    36	    private int interval = 1;
    37	    private boolean hasSettings;
    38	    private boolean lastThrottlingEnabled = true;
    39	    private int lastInterval = 1;
    40	
    41	    public void reset() {
    42	        this.armed = true;
    43	        this.cooldownRemaining = 0;
    44	        this.allowThisTick = false;
    45	        this.throttlingActive = false;
    46	        this.interval = 1;
    47	        // Keep last settings so a reload while stopped is still observed on the next beginTick.
    48	    }
    49	
    50	    /**
    51	     * Compute the single allow/deny decision for this goal tick from one atomic AI snapshot.
    52	     * Does not allocate.
    53	     *
    54	     * @param aiMoveSnapshot packed tuple from {@link PerformanceSettings#aiMoveSnapshot()}
    55	     */
    56	    public void beginTick(long aiMoveSnapshot) {
    57	        beginTick(
    58	                PerformanceSettings.aiMoveThrottlingEnabled(aiMoveSnapshot),
    59	                PerformanceSettings.aiMoveIntervalTicks(aiMoveSnapshot)
    60	        );
    61	    }
    62	
    63	    /**
    64	     * Compute the single allow/deny decision for this goal tick.
    65	     *
    66	     * @param throttlingEnabled live snapshot of {@code ai_move_throttling_enabled}
    67	     * @param intervalTicks live snapshot of {@code ai_move_interval_ticks}
    68	     */
    69	    public void beginTick(boolean throttlingEnabled, int intervalTicks) {
    70	        int sanitizedInterval = intervalTicks < 1 ? 1 : intervalTicks;
    71	        if (this.hasSettings
    72	                && (this.lastThrottlingEnabled != throttlingEnabled
    73	                || this.lastInterval != sanitizedInterval)) {
    74	            // Effective AI settings changed: drop old cooldown and rearm under the new tuple.
    75	            this.armed = true;
    76	            this.cooldownRemaining = 0;
    77	        }
    78	        this.hasSettings = true;
    79	        this.lastThrottlingEnabled = throttlingEnabled;
    80	        this.lastInterval = sanitizedInterval;
    81	        this.interval = sanitizedInterval;
    82	        this.throttlingActive = throttlingEnabled && sanitizedInterval > 1;
    83	        if (!this.throttlingActive) {
    84	            this.allowThisTick = true;
    85	            this.armed = true;
    86	            this.cooldownRemaining = 0;
    87	            return;
    88	        }
    89	        if (this.armed) {
    90	            this.allowThisTick = true;
    91	            return;
    92	        }
    93	        if (this.cooldownRemaining <= 0) {
    94	            this.allowThisTick = true;
