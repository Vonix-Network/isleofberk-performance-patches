    if (ntfsExtra.length != ntfsBeforeLen) {
        throw new GradleException('infoZipUxExtraFixture: NTFS extra-field length changed')
    }
    byte[] ntfsAfter = findZipExtraPayload(ntfsExtra, ntfsExtra.length, 0x000a)
    requireZipBytes('NTFS reserved', sliceZipBytes(ntfsAfter, 0, 4), ntfsReserved)
    byte[] ntfsTag1Header = new byte[4]
    zipW16(ntfsTag1Header, 0, 1)
    zipW16(ntfsTag1Header, 2, ntfsTag1Ts.length + ntfsTag1Sentinel.length)
    requireZipBytes('NTFS tag-1 header', sliceZipBytes(ntfsAfter, 4, 8), ntfsTag1Header)
    requireZipBytes('NTFS tag-1 timestamps', sliceZipBytes(ntfsAfter, 8, 32), new byte[24])
    requireZipBytes('NTFS tag-1 trailing', sliceZipBytes(ntfsAfter, 32, 36), ntfsTag1Sentinel)
    requireZipBytes('NTFS other attribute', sliceZipBytes(ntfsAfter, 36, ntfsAfter.length), zipNtfsAttribute(2, ntfsOtherPayload))

    expectGradleFailure('NTFS missing reserved prefix', 'NTFS 0x000a extra field missing reserved prefix') {
        zeroZipTimestampExtra(zipExtraBlock(0x000a, [0x11, 0x22] as byte[]), 0, 6)
    }
    expectGradleFailure('NTFS malformed attribute header', 'malformed NTFS 0x000a attribute header') {
        zeroZipTimestampExtra(zipExtraBlock(0x000a, concatZipBytes(ntfsReserved, [0x01, 0x00] as byte[])), 0, 10)
    }
    expectGradleFailure('NTFS truncated attribute record', 'truncated NTFS 0x000a attribute record') {
        byte[] truncatedRec = new byte[4 + 4 + 10]
        System.arraycopy(ntfsReserved, 0, truncatedRec, 0, 4)
        zipW16(truncatedRec, 4, 1)
        zipW16(truncatedRec, 6, 24)
