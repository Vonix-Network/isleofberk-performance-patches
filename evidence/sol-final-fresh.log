   108	    private static Map<String, byte[]> readJar(Path jar) throws IOException {
   109	        Map<String, byte[]> map = new TreeMap<>();
   110	        try (JarFile jf = new JarFile(jar.toFile())) {
   111	            Enumeration<JarEntry> entries = jf.entries();
   112	            while (entries.hasMoreElements()) {
   113	                JarEntry e = entries.nextElement();
   114	                if (e.isDirectory()) {
   115	                    continue;
   116	                }
   117	                try (InputStream in = jf.getInputStream(e)) {
   118	                    map.put(e.getName().replace('\\', '/'), in.readAllBytes());
   119	                }
   120	            }
   121	        }
   122	        return map;
   123	    }
   124	
   125	    private static String sha256(Path file) throws Exception {
   126	        MessageDigest digest = MessageDigest.getInstance("SHA-256");
   127	        try (InputStream in = Files.newInputStream(file)) {
   128	            byte[] buf = new byte[8192];
   129	            int n;
   130	            while ((n = in.read(buf)) >= 0) {
   131	                digest.update(buf, 0, n);
   132	            }
   133	        }
   134	        return HexFormat.of().formatHex(digest.digest()).toLowerCase(Locale.ROOT);
   135	    }
   136	
   137	    private static void require(boolean condition, String message) {
   138	        if (!condition) {
   139	            throw new AssertionError(message);
   140	        }
   141	    }
   142	}
