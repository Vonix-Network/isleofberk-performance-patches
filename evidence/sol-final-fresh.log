    byte[] gid = [0xEF, 0xBE] as byte[]
    byte[] zero8 = new byte[8]
    byte[] utTrailing = [0xC0, 0xFF, 0xEE] as byte[]
    byte[] unknownPayload = [0xFF, 0xEE] as byte[]
    byte[] ntfsReserved = [0x11, 0x22, 0x33, 0x44] as byte[]
    byte[] ntfsTag1Ts = fillZipBytes(24, 0x30)
    byte[] ntfsTag1Sentinel = [0xCA, 0xFE, 0xBA, 0xBE] as byte[]
    byte[] ntfsOtherPayload = [0xAB, 0xCD, 0xEF, 0x01] as byte[]
    byte[] uxTrailing = [0x99, 0x88] as byte[]

    // UT: flags + selected timestamps + trailing sentinel; unknown flag bits do not consume bytes.
    assertUtSelectedTimestamps(0x07, 3, utTrailing, 'UT flags 0x07 mtime/atime/ctime')
    assertUtSelectedTimestamps(0x01, 1, utTrailing, 'UT flags 0x01 mtime only')
    assertUtSelectedTimestamps(0x02, 1, utTrailing, 'UT flags 0x02 atime only')
    assertUtSelectedTimestamps(0x04, 1, utTrailing, 'UT flags 0x04 ctime only')
    assertUtSelectedTimestamps(0x03, 2, utTrailing, 'UT flags 0x03 mtime+atime')
    assertUtSelectedTimestamps(0x00, 0, utTrailing, 'UT flags 0x00 no timestamps')
