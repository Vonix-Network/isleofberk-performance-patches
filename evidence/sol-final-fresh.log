            throw new GradleException("candidateIdentityFixture: missing jar ${jar}")
        }
        def sha = java.security.MessageDigest.getInstance('SHA-256').digest(jar.bytes).encodeHex().toString()
        if (manifest.artifact?.sha256 != sha) {
            throw new GradleException("candidateIdentityFixture: manifest sha256 ${manifest.artifact?.sha256} != jar ${sha}")
        }
        if ((manifest.artifact?.size as Long) != jar.length()) {
            throw new GradleException("candidateIdentityFixture: manifest size mismatch")
        }
