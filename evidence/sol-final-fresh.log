   211	                .redirectErrorStream(true).start();
   212	        String output;
   213	        try (InputStream in = process.getInputStream()) {
   214	            output = read(in);
   215	        }
   216	        if (process.waitFor() != 0) {
   217	            throw new IOException("javap failed for " + className + ":\n" + output);
   218	        }
   219	        return output;
