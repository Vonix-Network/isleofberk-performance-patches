                'network/vonix/isleofberkperformance/internal/AiMoveCadence.class',
                'network/vonix/isleofberkperformance/internal/PerformanceSettings.class'
        ]
        def found = [] as Set
        new java.util.zip.ZipFile(jar).withCloseable { zip ->
            zip.entries().each { e -> found << e.name.replace('\\', '/') }
        }
        requiredClasses.each { c ->
            if (!found.contains(c)) {
                throw new GradleException("candidateIdentityFixture: jar missing ${c}")
            }
        }
        ['isleofberk', 'geckolib', 'variant_loader', 'deadlock_fix'].each { key ->
            def dep = manifest.dependencies?.get(key)
            if (dep == null || !dep.sha256) {
                throw new GradleException("candidateIdentityFixture: dependency ${key} digest missing from manifest")
            }
            def p = file(dep.path as String)
            if (!p.isFile()) {
                throw new GradleException("candidateIdentityFixture: dependency path missing ${p}")
            }
            def d = java.security.MessageDigest.getInstance('SHA-256').digest(p.bytes).encodeHex().toString()
            if (d != dep.sha256) {
                throw new GradleException("candidateIdentityFixture: dependency ${key} digest mismatch")
            }
        }
        def requiredTracked = manifest.tracked_build_inputs as List
        if (requiredTracked == null || requiredTracked.isEmpty()) {
            throw new GradleException('candidateIdentityFixture: tracked_build_inputs empty')
        }
        requiredTracked.each { rel ->
            def f = file("${root}/${rel}")
            if (!f.exists()) {
                throw new GradleException("candidateIdentityFixture: tracked input missing ${rel}")
            }
        }
        logger.lifecycle("candidateIdentityFixture: PASS (jar sha256=${sha}, classes+deps+tracked inputs verified)")
    }
}

