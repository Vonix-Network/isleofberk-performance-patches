   198	    private static String methodBody(String output, String declarationFragment) {
   199	        int method = output.indexOf(" " + declarationFragment);
   200	        int code = output.indexOf("Code:", method);
   201	        if (method < 0 || code < 0) {
   202	            return "";
   203	        }
   204	        Matcher next = Pattern.compile("\\n  (public |protected |private |static |\\})").matcher(output);
   205	        int end = next.find(code + 5) ? next.start() : output.length();
   206	        return output.substring(method, end);
   207	    }
