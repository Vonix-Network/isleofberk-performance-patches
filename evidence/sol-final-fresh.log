     1	package network.vonix.isleofberkperformance.internal;
     2	
     3	/**
     4	 * Reload-correct primitive snapshots of the COMMON spec. Mixins read only these values.
     5	 * Defaults match {@code PerformanceConfig} definitions and are replaced on Forge config
     6	 * load/reload — never frozen at class initialization from {@code ForgeConfigSpec.get()}.
     7	 *
     8	 * <p>The AI enabled flag and interval are published as one packed {@code long} snapshot so a
     9	 * reader observes a coherent tuple. Hot paths must call {@link #aiMoveSnapshot()} once per
    10	 * decision and unpack with {@link #aiMoveThrottlingEnabled(long)} / {@link #aiMoveIntervalTicks(long)}.
    11	 * Egg and shock intervals remain individual primitive snapshots.
    12	 */
    13	public final class PerformanceSettings {
    14	    private static final int AI_INTERVAL_MIN = 1;
    15	    private static final int AI_INTERVAL_MAX = 20;
    16	    private static final int CADENCE_MIN = 1;
    17	    private static final int CADENCE_MAX = 200;
    18	
    19	    /** Packed AI tuple: interval in the high 32 bits, enabled flag in bit 0. */
    20	    private static volatile long aiMoveSnapshot = packAiMove(true, 4);
    21	    private static volatile int eggHatchCheckIntervalTicks = 20;
    22	    private static volatile int shockParticleIntervalTicks = 8;
    23	
    24	    private PerformanceSettings() {}
    25	
    26	    public static void overwrite(
    27	            boolean throttlingEnabled,
    28	            int aiIntervalTicks,
    29	            int eggIntervalTicks,
    30	            int shockIntervalTicks
    31	    ) {
    32	        int clampedAi = clamp(aiIntervalTicks, AI_INTERVAL_MIN, AI_INTERVAL_MAX);
    33	        // Single volatile write publishes the coherent AI enabled/interval tuple.
    34	        aiMoveSnapshot = packAiMove(throttlingEnabled, clampedAi);
    35	        eggHatchCheckIntervalTicks = clamp(eggIntervalTicks, CADENCE_MIN, CADENCE_MAX);
    36	        shockParticleIntervalTicks = clamp(shockIntervalTicks, CADENCE_MIN, CADENCE_MAX);
    37	    }
    38	
    39	    /**
    40	     * Atomic AI enabled/interval snapshot. Read once per goal-tick decision; do not allocate.
    41	     */
    42	    public static long aiMoveSnapshot() {
    43	        return aiMoveSnapshot;
    44	    }
    45	
    46	    public static long packAiMove(boolean throttlingEnabled, int intervalTicks) {
    47	        int clamped = clamp(intervalTicks, AI_INTERVAL_MIN, AI_INTERVAL_MAX);
    48	        return (((long) clamped) << 32) | (throttlingEnabled ? 1L : 0L);
    49	    }
    50	
    51	    public static boolean aiMoveThrottlingEnabled(long snapshot) {
    52	        return (snapshot & 1L) != 0L;
    53	    }
    54	
    55	    public static int aiMoveIntervalTicks(long snapshot) {
    56	        return (int) (snapshot >>> 32);
    57	    }
    58	
    59	    public static boolean aiMoveThrottlingEnabled() {
    60	        return aiMoveThrottlingEnabled(aiMoveSnapshot);
    61	    }
    62	
    63	    public static int aiMoveIntervalTicks() {
    64	        return aiMoveIntervalTicks(aiMoveSnapshot);
    65	    }
    66	
    67	    public static int eggHatchCheckIntervalTicks() {
    68	        return eggHatchCheckIntervalTicks;
    69	    }
    70	
    71	    public static int shockParticleIntervalTicks() {
    72	        return shockParticleIntervalTicks;
    73	    }
    74	
    75	    private static int clamp(int value, int min, int max) {
    76	        if (value < min) {
    77	            return min;
    78	        }
    79	        if (value > max) {
    80	            return max;
    81	        }
    82	        return value;
    83	    }
    84	}

