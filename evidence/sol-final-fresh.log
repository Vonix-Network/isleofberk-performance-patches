   168	    private static List<Integer> invokePcs(String body, Pattern invoke) {
   169	        List<Integer> pcs = new ArrayList<>();
   170	        for (String line : instructionLines(body)) {
   171	            if (invoke.matcher(line).find()) {
   172	                Matcher pc = Pattern.compile("^\\s*(\\d+):").matcher(line);
   173	                if (pc.find()) {
   174	                    pcs.add(Integer.parseInt(pc.group(1)));
   175	                } else {
   176	                    pcs.add(-1);
   177	                }
   178	            }
   179	        }
   180	        return pcs;
   181	    }
