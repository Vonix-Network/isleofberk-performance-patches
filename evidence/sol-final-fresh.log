    }
    for (int i = 0; i < expected.length; i++) {
        if (actual[i] != expected[i]) {
            throw new GradleException("infoZipUxExtraFixture: ${label}: byte ${i} changed")
        }
    }
}

static byte[] buildMinimalStoredZip(String name, byte[] payload, byte[] extra, int dosTime, int dosDate) {
    byte[] nameBytes = name.getBytes('UTF-8')
    def crc32 = new java.util.zip.CRC32()
    crc32.update(payload)
    long crc = crc32.value
    int nameLen = nameBytes.length
    int extraLen = extra.length
    int localLen = 30 + nameLen + extraLen + payload.length
    int cdLen = 46 + nameLen + extraLen
    byte[] zip = new byte[localLen + cdLen + 22]
    int p = 0
    zipW32(zip, p, 0x04034b50L); p += 4
    zipW16(zip, p, 20); p += 2
    zipW16(zip, p, 0); p += 2
    zipW16(zip, p, 0); p += 2
    zipW16(zip, p, dosTime); p += 2
    zipW16(zip, p, dosDate); p += 2
    zipW32(zip, p, crc); p += 4
    zipW32(zip, p, payload.length); p += 4
    zipW32(zip, p, payload.length); p += 4
    zipW16(zip, p, nameLen); p += 2
    zipW16(zip, p, extraLen); p += 2
    System.arraycopy(nameBytes, 0, zip, p, nameLen); p += nameLen
    System.arraycopy(extra, 0, zip, p, extraLen); p += extraLen
    System.arraycopy(payload, 0, zip, p, payload.length); p += payload.length
    int cdOff = p
    zipW32(zip, p, 0x02014b50L); p += 4
    zipW16(zip, p, 20); p += 2
    zipW16(zip, p, 20); p += 2
    zipW16(zip, p, 0); p += 2
    zipW16(zip, p, 0); p += 2
    zipW16(zip, p, dosTime); p += 2
    zipW16(zip, p, dosDate); p += 2
    zipW32(zip, p, crc); p += 4
    zipW32(zip, p, payload.length); p += 4
    zipW32(zip, p, payload.length); p += 4
    zipW16(zip, p, nameLen); p += 2
    zipW16(zip, p, extraLen); p += 2
    zipW16(zip, p, 0); p += 2
    zipW16(zip, p, 0); p += 2
    zipW16(zip, p, 0); p += 2
    zipW32(zip, p, 0L); p += 4
    zipW32(zip, p, 0L); p += 4
    System.arraycopy(nameBytes, 0, zip, p, nameLen); p += nameLen
    System.arraycopy(extra, 0, zip, p, extraLen); p += extraLen
    zipW32(zip, p, 0x06054b50L); p += 4
    zipW16(zip, p, 0); p += 2
    zipW16(zip, p, 0); p += 2
    zipW16(zip, p, 1); p += 2
    zipW16(zip, p, 1); p += 2
    zipW32(zip, p, cdLen); p += 4
    zipW32(zip, p, cdOff); p += 4
    zipW16(zip, p, 0); p += 2
    return zip
}

static void expectGradleFailure(String label, String needle, Closure action) {
    try {
        action.call()
        throw new GradleException("infoZipUxExtraFixture: ${label} did not fail closed")
    } catch (GradleException ex) {
        if (ex.message != null && ex.message.contains('did not fail closed')) {
            throw ex
        }
        if (ex.message == null || !ex.message.contains(needle)) {
            throw new GradleException("infoZipUxExtraFixture: ${label}: unexpected failure: ${ex.message}")
        }
    }
}

static void assertUtSelectedTimestamps(int flags, int selectedCount, byte[] trailing, String label) {
    byte[] timestamps = fillZipBytes(selectedCount * 4, 0xA0)
    byte[] extra = zipExtraBlock(0x5455, concatZipBytes(zipSingleByte(flags), timestamps, trailing))
    int beforeLen = extra.length
    zeroZipTimestampExtra(extra, 0, extra.length)
    if (extra.length != beforeLen) {
        throw new GradleException("infoZipUxExtraFixture: ${label}: extra-field length changed")
    }
    byte[] after = findZipExtraPayload(extra, extra.length, 0x5455)
    requireZipBytes("${label} flags", sliceZipBytes(after, 0, 1), zipSingleByte(flags))
    requireZipBytes("${label} timestamps", sliceZipBytes(after, 1, 1 + timestamps.length), new byte[timestamps.length])
    if (trailing.length > 0) {
        requireZipBytes("${label} trailing", sliceZipBytes(after, 1 + timestamps.length, after.length), trailing)
    }
}

static void runInfoZipUxExtraFixture() {
    byte[] atime = [0x11, 0x22, 0x33, 0x44] as byte[]
    byte[] mtime = [0x55, 0x66, 0x77, 0x88] as byte[]
