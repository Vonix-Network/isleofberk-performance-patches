   236	    private static String sha256(Path file) throws Exception {
   237	        MessageDigest digest = MessageDigest.getInstance("SHA-256");
   238	        try (InputStream in = Files.newInputStream(file)) {
   239	            byte[] buf = new byte[8192];
   240	            int n;
   241	            while ((n = in.read(buf)) >= 0) {
   242	                digest.update(buf, 0, n);
   243	            }
   244	        }
   245	        return HexFormat.of().formatHex(digest.digest()).toLowerCase(Locale.ROOT);
   246	    }
