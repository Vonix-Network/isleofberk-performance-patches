    assertUtSelectedTimestamps(0x08, 0, utTrailing, 'UT flags 0x08 unknown bit only')

    expectGradleFailure('UT missing flags', 'Info-ZIP 0x5455 extra field missing flags') {
        zeroZipTimestampExtra(zipExtraBlock(0x5455, new byte[0]), 0, 4)
    }
    expectGradleFailure('UT truncated selected mtime', 'truncated Info-ZIP 0x5455 timestamp') {
        zeroZipTimestampExtra(zipExtraBlock(0x5455, concatZipBytes(zipSingleByte(0x01), [0x11, 0x22] as byte[])), 0, 7)
    }
    expectGradleFailure('UT truncated selected ctime', 'truncated Info-ZIP 0x5455 timestamp') {
        zeroZipTimestampExtra(zipExtraBlock(0x5455, concatZipBytes(zipSingleByte(0x07), fillZipBytes(8, 0x40))), 0, 13)
    }

    // NTFS: reserved prefix, tag 1 24-byte timestamps + trailing sentinel, other attribute.
    byte[] ntfsPayload = concatZipBytes(
            ntfsReserved,
            zipNtfsAttribute(1, concatZipBytes(ntfsTag1Ts, ntfsTag1Sentinel)),
            zipNtfsAttribute(2, ntfsOtherPayload)
    )
    byte[] ntfsExtra = zipExtraBlock(0x000a, ntfsPayload)
    int ntfsBeforeLen = ntfsExtra.length
