   121	            return SKIPPED_MOVE_TO_RESULT;
   122	        }
   123	        noteRequest();
   124	        return executedResult;
   125	    }
   126	
   127	    public boolean armed() {
   128	        return this.armed;
   129	    }
   130	
   131	    public int cooldownRemaining() {
   132	        return this.cooldownRemaining;
   133	    }
   134	
   135	    public int intervalSnapshot() {
   136	        return this.interval;
   137	    }
   138	
   139	    public boolean lastThrottlingEnabled() {
   140	        return this.lastThrottlingEnabled;
   141	    }
