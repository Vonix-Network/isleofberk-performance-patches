   183	    private static List<String> instructionLines(String body) {
   184	        List<String> lines = new ArrayList<>();
   185	        for (String raw : body.split("\\R")) {
   186	            String t = raw.trim();
   187	            if (t.matches("^\\d+:\\s+.*")) {
   188	                lines.add(t);
   189	            }
   190	        }
   191	        return lines;
   192	    }
