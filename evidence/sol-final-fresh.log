    }
    expectGradleFailure('NTFS tag-1 payload too short', 'NTFS 0x000a tag-1 timestamp payload too short') {
        zeroZipTimestampExtra(zipExtraBlock(0x000a, concatZipBytes(ntfsReserved, zipNtfsAttribute(1, fillZipBytes(16, 0x60)))), 0, 28)
    }

    // Combined extra stream: UT + UX + unknown blocks; only timestamps change.
    byte[] extra = concatZipBytes(
            zipExtraBlock(0x5455, concatZipBytes(zipSingleByte(0x07), fillZipBytes(12, 0x01), utTrailing)),
            zipExtraBlock(0x5855, concatZipBytes(infoZipUxPayload(atime, mtime, uid, gid), uxTrailing)),
