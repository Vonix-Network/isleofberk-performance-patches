static String extractSpecDefault(String spec, String defineCall, String fallback) {
    def matcher = (spec =~ /(?s)${java.util.regex.Pattern.quote(defineCall)},\s*(true|false)\s*\)/)
    if (!matcher.find()) {
        throw new GradleException("configFixture: PerformanceConfig.SPEC default not found for ${defineCall} (expected ${fallback})")
    }
    return matcher.group(1)
}

static String extractSpecRangeDefault(String spec, String defineCall, String fallback) {
    def matcher = (spec =~ /(?s)${java.util.regex.Pattern.quote(defineCall)},\s*(-?\d+)\s*,/)
    if (!matcher.find()) {
        throw new GradleException("configFixture: PerformanceConfig.SPEC default not found for ${defineCall} (expected ${fallback})")
    }
    return matcher.group(1)
}

