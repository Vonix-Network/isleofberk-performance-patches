    byte[] payload = 'sentinel-ux-payload\n'.getBytes('UTF-8')
    int dosTime = (12 << 11) | (34 << 5) | 28
    int dosDate = (30 << 9) | (6 << 5) | 15
    byte[] zipBytes = buildMinimalStoredZip(
            'ux-sentinel.txt',
            payload,
            zipExtra,
