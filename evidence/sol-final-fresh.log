   149	            if (line.equals("bipush        " + value) || line.equals("bipush " + value) || line.matches("bipush\\s+" + value)) {
   150	                require(i + 1 < lines.size(), label + " bipush " + value + " missing next insn");
   151	                String next = stripPc(lines.get(i + 1));
   152	                require(next.equals("irem"), label + " bipush " + value + " must be followed by irem, next=" + next + "\n" + body);
   153	                found++;
   154	            }
   155	        }
   156	        require(found == expected, label + " bipush/irem " + value + " expected " + expected + " got " + found + "\n" + body);
   157	    }
