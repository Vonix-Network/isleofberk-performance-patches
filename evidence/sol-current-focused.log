   645	    zipW16(zip, p, 20); p += 2
   646	    zipW16(zip, p, 0); p += 2
   647	    zipW16(zip, p, 0); p += 2
   648	    zipW16(zip, p, dosTime); p += 2
   649	    zipW16(zip, p, dosDate); p += 2
   650	    zipW32(zip, p, crc); p += 4
   651	    zipW32(zip, p, payload.length); p += 4
   652	    zipW32(zip, p, payload.length); p += 4
   653	    zipW16(zip, p, nameLen); p += 2
   654	    zipW16(zip, p, extraLen); p += 2
   655	    System.arraycopy(nameBytes, 0, zip, p, nameLen); p += nameLen
   656	    System.arraycopy(extra, 0, zip, p, extraLen); p += extraLen
   657	    System.arraycopy(payload, 0, zip, p, payload.length); p += payload.length
