   560	static byte[] zipExtraBlock(int id, byte[] payload) {
   561	    byte[] block = new byte[4 + payload.length]
   562	    zipW16(block, 0, id)
   563	    zipW16(block, 2, payload.length)
   564	    System.arraycopy(payload, 0, block, 4, payload.length)
   565	    return block
   566	}
