    94	/**
    95	 * ForgeGradle reobfJar (RenameJarInPlace / SpecialSource JarOutputStream) always
    96	 * rewrites ZIP timestamps and may rewrite extra fields. Gradle Jar reproducibility
    97	 * settings do not apply to that in-place rename. This task only canonicalizes ZIP
    98	 * metadata: entry contents, order, manifest, refmap, and bytecode stay unchanged.
    99	 */
   100	tasks.register('canonicalizeReobfJar') {
   101	    group = 'build'
   102	    description = 'Canonicalize ZIP timestamps/extra metadata on the reobfuscated primary JAR.'
   103	    dependsOn 'reobfJar'
   104	    doLast {
   105	        def primary = file("${buildDir}/libs/${archivesBaseName}-${project.version}.jar")
   106	        canonicalizeReobfZipMetadata(primary)
   107	        logger.lifecycle("canonicalizeReobfJar: deterministic ZIP metadata written for ${primary.name}")
   108	    }
   109	}
