   325	/**
   326	 * Deterministic read-only extra-field fixture. Does not mutate the release JAR.
   327	 * Builds synthetic Info-ZIP 0x5455 (UT), NTFS 0x000a, and Info-ZIP 0x5855 (UX)
   328	 * payloads and proves canonicalizeReobfZipMetadata / zeroZipTimestampExtra
   329	 * change only selected timestamp bytes. Flags, reserved prefix, UID/GID,
   330	 * other attributes, and trailing/unknown bytes are preserved. Malformed,
   331	 * truncated, zero-length, and short timestamp layouts fail closed.
   332	 */
   333	tasks.register('infoZipUxExtraFixture') {
   334	    group = 'verification'
   335	    description = 'Checks UT/NTFS/UX timestamps are canonicalized while non-timestamp bytes are preserved.'
   336	    doLast {
   337	        runInfoZipUxExtraFixture()
   338	    }
   339	}
   340	
   341	static int zipU16(byte[] bytes, int offset) {
   342	    return (bytes[offset] & 0xff) | ((bytes[offset + 1] & 0xff) << 8)
   343	}
   344	
   345	static long zipU32(byte[] bytes, int offset) {
   346	    return (bytes[offset] & 0xffL) |
   347	            ((bytes[offset + 1] & 0xffL) << 8) |
   348	            ((bytes[offset + 2] & 0xffL) << 16) |
   349	            ((bytes[offset + 3] & 0xffL) << 24)
   350	}
   351	
   352	static void zipW16(byte[] bytes, int offset, int value) {
   353	    bytes[offset] = (byte) (value & 0xff)
   354	    bytes[offset + 1] = (byte) ((value >> 8) & 0xff)
   355	}
   356	
   357	static void zipW32(byte[] bytes, int offset, long value) {
   358	    bytes[offset] = (byte) (value & 0xff)
   359	    bytes[offset + 1] = (byte) ((value >> 8) & 0xff)
   360	    bytes[offset + 2] = (byte) ((value >> 16) & 0xff)
   361	    bytes[offset + 3] = (byte) ((value >> 24) & 0xff)
   362	}
   363	
   364	static void zeroZipTimestampExtra(byte[] bytes, int offset, int length) {
   365	    int cursor = 0
   366	    while (cursor + 4 <= length) {
   367	        int id = zipU16(bytes, offset + cursor)
   368	        int size = zipU16(bytes, offset + cursor + 2)
   369	        if (cursor + 4 + size > length) {
   370	            if (id == 0x5455) {
   371	                throw new GradleException("canonicalizeReobfJar: truncated Info-ZIP 0x5455 extra field")
   372	            }
   373	            if (id == 0x000a) {
   374	                throw new GradleException("canonicalizeReobfJar: truncated NTFS 0x000a extra field")
   375	            }
   376	            if (id == 0x5855) {
   377	                throw new GradleException("canonicalizeReobfJar: truncated Info-ZIP 0x5855 extra field")
   378	            }
   379	            break
   380	        }
   381	        int payload = offset + cursor + 4
   382	        if (id == 0x5455) {
   383	            // UT extra: flags bits 0x01/0x02/0x04 select mtime/atime/ctime.
   384	            // Zero only selected timestamp bytes; preserve flags and trailing/unknown bytes.
   385	            if (size < 1) {
   386	                throw new GradleException("canonicalizeReobfJar: Info-ZIP 0x5455 extra field missing flags")
   387	            }
   388	            int flags = bytes[payload] & 0xff
   389	            int tsCursor = 1
   390	            [0x01, 0x02, 0x04].each { bit ->
   391	                if ((flags & bit) != 0) {
   392	                    if (tsCursor + 4 > size) {
   393	                        throw new GradleException("canonicalizeReobfJar: truncated Info-ZIP 0x5455 timestamp")
   394	                    }
   395	                    for (int i = 0; i < 4; i++) {
   396	                        bytes[payload + tsCursor + i] = 0
   397	                    }
   398	                    tsCursor += 4
   399	                }
   400	            }
   401	        } else if (id == 0x5855) {
   402	            // Info-ZIP Unix extra (UX): AcTime(4) + ModTime(4) [+ UID(2) + GID(2)].
   403	            // Canonicalize only timestamp bytes; preserve UID/GID and any trailing bytes.
   404	            if (size < 8) {
   405	                throw new GradleException("canonicalizeReobfJar: truncated Info-ZIP 0x5855 timestamp payload")
   406	            }
   407	            for (int i = 0; i < 8; i++) {
   408	                bytes[payload + i] = 0
   409	            }
   410	        } else if (id == 0x000a) {
   411	            // NTFS extra: 4-byte reserved prefix, then tag/size/payload records.
   412	            if (size < 4) {
   413	                throw new GradleException("canonicalizeReobfJar: NTFS 0x000a extra field missing reserved prefix")
   414	            }
   415	            int tagCursor = 4
   416	            while (tagCursor < size) {
   417	                if (tagCursor + 4 > size) {
   418	                    throw new GradleException("canonicalizeReobfJar: malformed NTFS 0x000a attribute header")
   419	                }
   420	                int tag = zipU16(bytes, payload + tagCursor)
   421	                int tagSize = zipU16(bytes, payload + tagCursor + 2)
   422	                if (tagCursor + 4 + tagSize > size) {
   423	                    throw new GradleException("canonicalizeReobfJar: truncated NTFS 0x000a attribute record")
   424	                }
   425	                if (tag == 1) {
   426	                    if (tagSize < 24) {
   427	                        throw new GradleException("canonicalizeReobfJar: NTFS 0x000a tag-1 timestamp payload too short")
   428	                    }
   429	                    for (int i = 0; i < 24; i++) {
   430	                        bytes[payload + tagCursor + 4 + i] = 0
   431	                    }
   432	                }
   433	                tagCursor += 4 + tagSize
   434	            }
   435	        }
   436	        cursor += 4 + size
   437	    }
   438	}
   439	
   440	static void canonicalizeReobfZipMetadata(File jarFile) {
   441	    if (!jarFile.isFile()) {
   442	        throw new GradleException("canonicalizeReobfJar: expected reobfuscated JAR missing: ${jarFile}")
   443	    }
   444	    byte[] bytes = jarFile.bytes
   445	    if (bytes.length < 22) {
   446	        throw new GradleException("canonicalizeReobfJar: ${jarFile.name} is too small to be a ZIP")
   447	    }
   448	
   449	    int eocd = -1
   450	    int minEocd = Math.max(0, bytes.length - 22 - 0xFFFF)
   451	    for (int i = bytes.length - 22; i >= minEocd; i--) {
   452	        if (zipU32(bytes, i) == 0x06054b50L) {
   453	            eocd = i
   454	            break
   455	        }
   456	    }
   457	    if (eocd < 0) {
   458	        throw new GradleException("canonicalizeReobfJar: ZIP end-of-central-directory not found in ${jarFile.name}")
   459	    }
   460	    int commentLen = zipU16(bytes, eocd + 20)
   461	    if (eocd + 22 + commentLen != bytes.length) {
   462	        throw new GradleException("canonicalizeReobfJar: ZIP64 or trailing data is not supported for ${jarFile.name}")
   463	    }
   464	    if (eocd >= 20 && zipU32(bytes, eocd - 20) == 0x07064b50L) {
   465	        throw new GradleException("canonicalizeReobfJar: ZIP64 locator is not supported for ${jarFile.name}")
   466	    }
   467	
   468	    int entryCount = zipU16(bytes, eocd + 10)
   469	    long cdSize = zipU32(bytes, eocd + 12)
   470	    long cdOffset = zipU32(bytes, eocd + 16)
   471	    if (cdOffset + cdSize != eocd) {
   472	        throw new GradleException("canonicalizeReobfJar: central directory bounds are invalid in ${jarFile.name}")
   473	    }
   474	
   475	    def before = [] as List
   476	    // DOS 1980-02-01 00:00:00; same fixed date Gradle uses for reproducible JARs.
   477	    int dosTime = 0
   478	    int dosDate = (0 << 9) | (2 << 5) | 1
   479	    int pos = (int) cdOffset
   480	    for (int n = 0; n < entryCount; n++) {
   481	        if (pos + 46 > bytes.length || zipU32(bytes, pos) != 0x02014b50L) {
   482	            throw new GradleException("canonicalizeReobfJar: central directory entry ${n} is invalid")
   483	        }
   484	        int nameLen = zipU16(bytes, pos + 28)
   485	        int extraLen = zipU16(bytes, pos + 30)
   486	        int fileCommentLen = zipU16(bytes, pos + 32)
   487	        long localOffset = zipU32(bytes, pos + 42)
   488	        int local = (int) localOffset
   489	        if (local + 30 > bytes.length || zipU32(bytes, local) != 0x04034b50L) {
   490	            throw new GradleException("canonicalizeReobfJar: local header for entry ${n} is invalid")
   491	        }
   492	        int localNameLen = zipU16(bytes, local + 26)
   493	        int localExtraLen = zipU16(bytes, local + 28)
   494	        String name = new String(bytes, pos + 46, nameLen, 'UTF-8')
   495	        if (localNameLen != nameLen || new String(bytes, local + 30, localNameLen, 'UTF-8') != name) {
   496	            throw new GradleException("canonicalizeReobfJar: local/central name mismatch for ${name}")
   497	        }
   498	        before << [
   499	                name          : name,
   500	                crc           : zipU32(bytes, pos + 16),
   501	                compressed    : zipU32(bytes, pos + 20),
   502	                uncompressed  : zipU32(bytes, pos + 24)
   503	        ]
   504	
   505	        zipW16(bytes, pos + 12, dosTime)
   506	        zipW16(bytes, pos + 14, dosDate)
   507	        zeroZipTimestampExtra(bytes, pos + 46 + nameLen, extraLen)
   508	
   509	        zipW16(bytes, local + 10, dosTime)
