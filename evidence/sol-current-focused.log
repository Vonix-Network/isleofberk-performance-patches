   568	static byte[] zipNtfsAttribute(int tag, byte[] attrPayload) {
   569	    byte[] rec = new byte[4 + attrPayload.length]
   570	    zipW16(rec, 0, tag)
   571	    zipW16(rec, 2, attrPayload.length)
   572	    System.arraycopy(attrPayload, 0, rec, 4, attrPayload.length)
   573	    return rec
   574	}
