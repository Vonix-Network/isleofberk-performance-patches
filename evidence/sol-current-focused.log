   660	    zipW16(zip, p, 20); p += 2
   661	    zipW16(zip, p, 20); p += 2
   662	    zipW16(zip, p, 0); p += 2
   663	    zipW16(zip, p, 0); p += 2
   664	    zipW16(zip, p, dosTime); p += 2
   665	    zipW16(zip, p, dosDate); p += 2
   666	    zipW32(zip, p, crc); p += 4
   667	    zipW32(zip, p, payload.length); p += 4
   668	    zipW32(zip, p, payload.length); p += 4
   669	    zipW16(zip, p, nameLen); p += 2
   670	    zipW16(zip, p, extraLen); p += 2
   671	    zipW16(zip, p, 0); p += 2
   672	    zipW16(zip, p, 0); p += 2
   673	    zipW16(zip, p, 0); p += 2
   674	    zipW32(zip, p, 0L); p += 4
   675	    zipW32(zip, p, 0L); p += 4
