    54	    private static String javap(Path jar, String className) throws Exception {
    55	        Process process = new ProcessBuilder("javap", "-classpath", jar.toAbsolutePath().toString(), "-p", "-c", className)
    56	                .redirectErrorStream(true).start();
    57	        String output;
    58	        try (InputStream input = process.getInputStream()) {
    59	            output = read(input);
    60	        }
    61	        if (process.waitFor() != 0) {
    62	            throw new IOException("javap failed for " + className + ":\n" + output);
    63	        }
    64	        return output;
    65	    }
