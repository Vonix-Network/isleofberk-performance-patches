   681	    zipW16(zip, p, 1); p += 2
   682	    zipW16(zip, p, 1); p += 2
   683	    zipW32(zip, p, cdLen); p += 4
   684	    zipW32(zip, p, cdOff); p += 4
   685	    zipW16(zip, p, 0); p += 2
   686	    return zip
   687	}
