   610	static byte[] sliceZipBytes(byte[] src, int from, int toExclusive) {
   611	    if (src == null || from < 0 || toExclusive < from || toExclusive > src.length) {
   612	        throw new GradleException("infoZipUxExtraFixture: invalid slice ${from}..${toExclusive} of ${src == null ? -1 : src.length}")
   613	    }
   614	    byte[] out = new byte[toExclusive - from]
   615	    System.arraycopy(src, from, out, 0, out.length)
   616	    return out
   617	}
