   576	static byte[] fillZipBytes(int length, int startValue) {
   577	    byte[] out = new byte[length]
   578	    for (int i = 0; i < length; i++) {
   579	        out[i] = (byte) ((startValue + i) & 0xff)
   580	    }
   581	    return out
   582	}
