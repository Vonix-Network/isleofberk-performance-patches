   592	static byte[] findZipExtraPayload(byte[] extra, int extraLength, int wantedId) {
   593	    int cursor = 0
   594	    while (cursor + 4 <= extraLength) {
   595	        int id = zipU16(extra, cursor)
   596	        int size = zipU16(extra, cursor + 2)
   597	        if (cursor + 4 + size > extraLength) {
   598	            throw new GradleException("infoZipUxExtraFixture: truncated extra field 0x${Integer.toHexString(id)}")
   599	        }
   600	        if (id == wantedId) {
   601	            byte[] payload = new byte[size]
   602	            System.arraycopy(extra, cursor + 4, payload, 0, size)
   603	            return payload
   604	        }
   605	        cursor += 4 + size
   606	    }
   607	    return null
   608	}
