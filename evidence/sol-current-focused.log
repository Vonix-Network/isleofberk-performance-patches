   546	static byte[] concatZipBytes(byte[]... parts) {
   547	    int total = 0
   548	    for (int i = 0; i < parts.length; i++) {
   549	        total += parts[i].length
   550	    }
   551	    byte[] out = new byte[total]
   552	    int pos = 0
   553	    for (int i = 0; i < parts.length; i++) {
   554	        System.arraycopy(parts[i], 0, out, pos, parts[i].length)
   555	        pos += parts[i].length
   556	    }
   557	    return out
   558	}
