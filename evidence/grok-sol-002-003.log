+
+/**
+ * Focused SOL-003 checks: egg/shock recurring handlers use PerformanceSettings primitives,
+ * and snapshot overwrite is visible to those accessors without Forge config objects.
+ */
+public final class PerformanceSettingsSnapshotFixture {
+    private PerformanceSettingsSnapshotFixture() {}
+
+    public static void main(String[] args) throws Exception {
+        // Defaults.
+        PerformanceSettings.overwrite(true, 4, 20, 8);
+        require(PerformanceSettings.eggHatchCheckIntervalTicks() == 20, "default egg interval");
+        require(PerformanceSettings.shockParticleIntervalTicks() == 8, "default shock interval");
+
+        // Coherent AI tuple via one packed snapshot.
+        long snap = PerformanceSettings.aiMoveSnapshot();
+        require(PerformanceSettings.aiMoveThrottlingEnabled(snap), "default AI enabled from snapshot");
+        require(PerformanceSettings.aiMoveIntervalTicks(snap) == 4, "default AI interval from snapshot");
+
+        // Reload all four keys; readers must observe new values.
+        PerformanceSettings.overwrite(false, 6, 15, 12);
+        long reloaded = PerformanceSettings.aiMoveSnapshot();
+        require(!PerformanceSettings.aiMoveThrottlingEnabled(reloaded), "reload AI enabled=false");
+        require(PerformanceSettings.aiMoveIntervalTicks(reloaded) == 6, "reload AI interval=6");
+        require(PerformanceSettings.eggHatchCheckIntervalTicks() == 15, "reload egg=15");
+        require(PerformanceSettings.shockParticleIntervalTicks() == 12, "reload shock=12");
+
+        // Unrelated "event" simulation: calling overwrite with same values must keep snapshots stable.
+        PerformanceSettings.overwrite(false, 6, 15, 12);
+        require(PerformanceSettings.aiMoveSnapshot() == reloaded
+                        || (PerformanceSettings.aiMoveIntervalTicks() == 6
+                        && !PerformanceSettings.aiMoveThrottlingEnabled()
+                        && PerformanceSettings.eggHatchCheckIntervalTicks() == 15
+                        && PerformanceSettings.shockParticleIntervalTicks() == 12),
+                "repeat overwrite must keep coherent values");
+
+        // Mixin methods exist and return PerformanceSettings primitives when invoked reflectively
+        // with dummy upstream constants (no Minecraft runtime required for the method body).
+        Method egg = ADragonEggBaseMixin.class.getDeclaredMethod("vonix$configureHatchCheckInterval", int.class);
+        egg.setAccessible(true);
+        ADragonEggBaseMixin eggMixin = (ADragonEggBaseMixin) unsafeAllocate(ADragonEggBaseMixin.class);
+        Object eggValue = egg.invoke(eggMixin, 20);
+        require(eggValue instanceof Integer && ((Integer) eggValue) == 15,
+                "egg mixin must return PerformanceSettings egg snapshot, got " + eggValue);
+
+        Method shock = ShockEffectMixin.class.getDeclaredMethod("vonix$configureParticleInterval", int.class);
+        shock.setAccessible(true);
+        ShockEffectMixin shockMixin = (ShockEffectMixin) unsafeAllocate(ShockEffectMixin.class);
+        Object shockValue = shock.invoke(shockMixin, 8);
+        require(shockValue instanceof Integer && ((Integer) shockValue) == 12,
+                "shock mixin must return PerformanceSettings shock snapshot, got " + shockValue);
+
+        // Restore defaults for subsequent fixtures in the same JVM if any.
+        PerformanceSettings.overwrite(true, 4, 20, 8);
+
+        // Bytecode of mixin classes must reference PerformanceSettings and must not contain
+        // ConfigValue get owner markers used by ForgeConfigSpec getters.
+        for (String className : List.of(
+                ADragonEggBaseMixin.class.getName(),
+                ShockEffectMixin.class.getName()
