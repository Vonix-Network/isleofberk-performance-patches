evidence/grok-sol-004-007.log:222:+        Map<String, byte[]> companionEntries = readJar(companion);
evidence/grok-sol-004-007.log:224:+        Map<String, byte[]> deadlockEntries = readJar(deadlock);
evidence/grok-sol-004-007.log:226:+        require(companionEntries.containsKey("isleofberkperformance.mixins.json"), "companion mixins.json missing");
evidence/grok-sol-004-007.log:227:+        require(companionEntries.containsKey("network/vonix/isleofberkperformance/internal/AiMoveCadence.class"),
evidence/grok-sol-004-007.log:228:+                "companion missing AiMoveCadence");
