plugins {
    id 'eclipse'
    id 'idea'
    id 'net.minecraftforge.gradle' version '5.1.77'
    id 'org.spongepowered.mixin' version '0.7.38'
}

def forgeVersion = project.findProperty('forgeVersion') ?: '40.3.0'
def iobVersion = project.findProperty('iobVersion') ?: '1.2.0'
def serverRunDir = project.findProperty('serverRunDir')
def runtimeArtifact = project.findProperty('runtimeArtifact')
version = project.findProperty('version') ?: '0.1.0'
group = 'network.vonix.isleofberkperformance'
// Companion performance-patch artifact name (not an IoB fork/replacement).
archivesBaseName = 'isleof-berk-performance-patches'

java.toolchain.languageVersion = JavaLanguageVersion.of(17)

minecraft {
    mappings channel: 'official', version: '1.18.2'
    runs {
        client {
            workingDirectory project.file('run')
            property 'forge.logging.markers', 'REGISTRIES'
            property 'forge.logging.console.level', 'debug'
            property 'mixin.env.remapRefMap', 'true'
            property 'mixin.env.refMapRemappingFile', "${projectDir}/build/createSrgToMcp/output.srg"
            mods { isleofberkperformance { source sourceSets.main } }
        }
        server {
            workingDirectory project.file(serverRunDir ?: 'run')
            property 'forge.logging.markers', 'REGISTRIES'
            property 'forge.logging.console.level', 'debug'
            property 'mixin.env.remapRefMap', 'true'
            property 'mixin.env.refMapRemappingFile', "${projectDir}/build/createSrgToMcp/output.srg"
            if (!runtimeArtifact) {
                mods { isleofberkperformance { source sourceSets.main } }
            }
        }
    }
}

mixin {
    add sourceSets.main, 'isleofberkperformance.refmap.json'
    config 'isleofberkperformance.mixins.json'
}

repositories {
    mavenCentral()
    flatDir { dirs 'libs' }
}

dependencies {
    minecraft "net.minecraftforge:forge:1.18.2-${forgeVersion}"
    // Compile against original IoB + GeckoLib; never shade/bundle them into this companion JAR.
    compileOnly fg.deobf("local:isleofberk-${iobVersion}:${iobVersion}")
    compileOnly fg.deobf('local:geckolib-forge-1.18-3.0.57:3.0.57')
    runtimeOnly fg.deobf("local:isleofberk-${iobVersion}:${iobVersion}")
    runtimeOnly fg.deobf('local:geckolib-forge-1.18-3.0.57:3.0.57')
    annotationProcessor 'org.spongepowered:mixin:0.8.5:processor'
}

processResources {
    inputs.properties([version: project.version])
    filesMatching('META-INF/mods.toml') {
        // mods.toml pins the original Isle of Berk dependency to [1.2.0,1.2.0.1).
        expand(version: project.version)
    }
}

jar {
    duplicatesStrategy = DuplicatesStrategy.EXCLUDE
    manifest {
        attributes([
            'Specification-Title'     : 'isleof-berk-performance-patches',
            'Specification-Vendor'    : 'Vonix-Network',
            'Specification-Version'   : '1',
            'Implementation-Title'    : 'Isle of Berk Performance Patches (companion)',
            'Implementation-Version'  : project.version,
            'Implementation-Vendor'   : 'Vonix-Network',
            'MixinConfigs'            : 'isleofberkperformance.mixins.json'
        ])
    }
}

// Keep release artifacts byte-for-byte reproducible across clean builds.
tasks.withType(Jar).configureEach {
    preserveFileTimestamps = false
    reproducibleFileOrder = true
}

jar.finalizedBy('reobfJar')

/**
 * ForgeGradle reobfJar (RenameJarInPlace / SpecialSource JarOutputStream) always
 * rewrites ZIP timestamps and may rewrite extra fields. Gradle Jar reproducibility
 * settings do not apply to that in-place rename. This task only canonicalizes ZIP
 * metadata: entry contents, order, manifest, refmap, and bytecode stay unchanged.
 */
tasks.register('canonicalizeReobfJar') {
    group = 'build'
    description = 'Canonicalize ZIP timestamps/extra metadata on the reobfuscated primary JAR.'
    dependsOn 'reobfJar'
    doLast {
        def primary = file("${buildDir}/libs/${archivesBaseName}-${project.version}.jar")
        canonicalizeReobfZipMetadata(primary)
        logger.lifecycle("canonicalizeReobfJar: deterministic ZIP metadata written for ${primary.name}")
    }
}

tasks.configureEach { task ->
    if (task.name == 'reobfJar') {
        task.finalizedBy 'canonicalizeReobfJar'
    }
}

/**
 * Rejects a packaged primary JAR that bundles Isle of Berk implementation classes/resources
 * or deadlock-fix package/resource markers. Companion-only scope enforcement.
 * Descriptive mentions of the separate deadlock-fix mod in mods.toml are allowed.
 */
tasks.register('auditPackagedJar') {
    group = 'verification'
    description = 'Fails if the primary JAR bundles IoB classes/resources or deadlock-fix markers.'
    dependsOn 'canonicalizeReobfJar'
    doLast {
        def libsDir = file("${buildDir}/libs")
        def expectedName = "${archivesBaseName}-${project.version}.jar"
        def primary = file("${libsDir}/${expectedName}")
        if (!primary.isFile()) {
            throw new GradleException("auditPackagedJar: expected primary JAR missing: ${primary}")
        }
        def forbiddenPathPrefixes = [
                'com/GACMD/isleofberk/',
                'network/vonix/isleofberkdeadlockfix/'
        ]
        // Packaged deadlock-fix artifact markers (not prose about the separate optional mod).
        def forbiddenExactResources = [
                'isleofberkdeadlockfix.mixins.json',
                'isleofberkdeadlockfix.refmap.json'
        ] as Set
        def forbiddenClassNameMarkers = [
                'IsleOfBerkDeadlockFix',
                'ADragonBaseMixin',
                'AltFollowGoalMixin'
        ]
        def allowedClassPrefix = 'network/vonix/isleofberkperformance/'
        def allowedNonClass = [
                'pack.mcmeta',
                'isleofberkperformance.mixins.json',
                'isleofberkperformance.refmap.json',
                'META-INF/mods.toml',
                'META-INF/MANIFEST.MF'
        ] as Set

        def violations = [] as List
        def classEntries = [] as List
        def resourceEntries = [] as List
        java.util.zip.ZipFile zip = new java.util.zip.ZipFile(primary)
        try {
            zip.entries().each { entry ->
                def normalized = entry.name.replace('\\', '/')
                if (normalized.endsWith('/')) {
                    return
                }
                forbiddenPathPrefixes.each { prefix ->
                    if (normalized.startsWith(prefix)) {
                        violations << "forbidden bundled path: ${normalized}"
                    }
                }
                if (forbiddenExactResources.contains(normalized)) {
                    violations << "forbidden deadlock-fix resource: ${normalized}"
                }
                // Any path segment that is the deadlock-fix package/mod id as a resource root.
                if (normalized == 'isleofberkdeadlockfix' || normalized.startsWith('isleofberkdeadlockfix/')) {
                    violations << "forbidden deadlock-fix marker path: ${normalized}"
                }
                if (normalized.endsWith('.class')) {
                    classEntries << normalized
                    if (!normalized.startsWith(allowedClassPrefix)) {
                        violations << "unexpected class outside companion package: ${normalized}"
                    }
                    def simple = normalized.substring(normalized.lastIndexOf('/') + 1).replace('.class', '')
                    forbiddenClassNameMarkers.each { marker ->
                        if (simple == marker || simple.endsWith(marker)) {
                            violations << "forbidden deadlock-fix class marker: ${normalized}"
                        }
                    }
                } else {
                    resourceEntries << normalized
                    if (!allowedNonClass.contains(normalized)) {
                        violations << "unexpected resource outside companion allowlist: ${normalized}"
                    }
                }
            }
        } finally {
            zip.close()
        }

        if (classEntries.isEmpty()) {
            violations << 'primary JAR contains no companion classes'
        }
        if (!violations.isEmpty()) {
            throw new GradleException("auditPackagedJar FAILED for ${primary.name}:\n  - " + violations.join('\n  - '))
        }
        logger.lifecycle(
                "auditPackagedJar OK: ${primary.name} (${classEntries.size()} classes, ${resourceEntries.size()} resources, companion-only)"
        )
    }
}

tasks.named('build').configure {
    dependsOn 'auditPackagedJar'
}

tasks.named('check').configure {
    dependsOn 'auditPackagedJar'
    dependsOn 'mappingFixture'
    dependsOn 'rendererBytecodeFixture'
