}

tasks.register('mappingFixture') {
    group = 'verification'
    description = 'Checks the WrappedGoal official-to-SRG accessor mapping in the packaged artifact.'
    dependsOn 'canonicalizeReobfJar'
    doLast {
        def primary = file("${buildDir}/libs/${archivesBaseName}-${project.version}.jar")
        def refmap = new java.util.zip.ZipFile(primary).withCloseable { zip ->
            def entry = zip.getEntry('isleofberkperformance.refmap.json')
            if (entry == null) {
                throw new GradleException("mappingFixture: packaged refmap missing from ${primary}")
            }
            zip.getInputStream(entry).getText('UTF-8')
        }
        if (!refmap.contains('WrappedGoal;m_8056_') || !refmap.contains('WrappedGoal;m_8041_')) {
            throw new GradleException('mappingFixture: packaged refmap is missing the SRG WrappedGoal start/stop selectors')
        }
        if (refmap.contains('WrappedGoal;getGoal')) {
            throw new GradleException('mappingFixture: packaged refmap contains an unmapped WrappedGoal selector')
        }

        def srg = file("${buildDir}/createMcpToSrg/output.tsrg").getText('UTF-8')
        if (!srg.contains('getGoal ()Lnet/minecraft/world/entity/ai/goal/Goal; m_26015_')) {
            throw new GradleException('mappingFixture: pinned official-to-SRG mapping does not contain getGoal -> m_26015_')
        }
        def classBytes = new java.util.zip.ZipFile(primary).withCloseable { zip ->
            def entry = zip.getEntry('network/vonix/isleofberkperformance/mixin/WrappedGoalMixin.class')
