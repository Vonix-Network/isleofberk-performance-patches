    54	    private static String javap(Path jar, String className) throws Exception {
    55	        Process process = new ProcessBuilder("javap", "-classpath", jar.toAbsolutePath().toString(), "-p", "-c", className)
    56	                .redirectErrorStream(true).start();
    57	        String output;
    58	        try (InputStream input = process.getInputStream()) {
    59	            output = read(input);
    60	        }
    61	        if (process.waitFor() != 0) {
    62	            throw new IOException("javap failed for " + className + ":\n" + output);
    63	        }
    64	        return output;
    65	    }
    66	
    67	    private static String methodBody(String output, String declarationFragment) {
    68	        int method = output.indexOf(" " + declarationFragment);
    69	        int code = output.indexOf("Code:", method);
    70	        if (method < 0 || code < 0) {
    71	            return "";
    72	        }
    73	        Matcher next = Pattern.compile("\\n  (public |protected |private |static |\\})").matcher(output);
    74	        int end = next.find(code + 5) ? next.start() : output.length();
    75	        return output.substring(method, end);
    76	    }
    77	
    78	    private static int count(Pattern pattern, String body) {
    79	        int matches = 0;
    80	        Matcher matcher = pattern.matcher(body);
    81	        while (matcher.find()) {
    82	            matches++;
    83	        }
    84	        return matches;
    85	    }
    86	
    87	    private static int countBipush(String body, int value) {
    88	        int matches = 0;
    89	        Matcher matcher = BIPUSH.matcher(body);
    90	        while (matcher.find()) {
    91	            if (Integer.parseInt(matcher.group(1)) == value) {
    92	                matches++;
    93	            }
    94	        }
    95	        return matches;
    96	    }
    97	
    98	    private static String read(InputStream input) throws IOException {
    99	        ByteArrayOutputStream output = new ByteArrayOutputStream();
   100	        input.transferTo(output);
   101	        return output.toString(StandardCharsets.UTF_8);
   102	    }
   103	
   104	    private static void require(boolean condition, String message) {
   105	        if (!condition) {
   106	            throw new AssertionError(message);
   107	        }
   108	    }
   109	}

