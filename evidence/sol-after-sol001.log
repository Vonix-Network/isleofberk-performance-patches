+        def sourceHits = [] as List
+        sourceRoots.each { root ->
+            if (!root.isDirectory()) {
+                return
+            }
+            root.eachFileRecurse(groovy.io.FileType.FILES) { f ->
+                if (!f.name.endsWith('.java')) {
+                    return
+                }
+                def text = f.getText('UTF-8')
+                forbidden.each { token ->
+                    if (text.contains(token)) {
+                        sourceHits << "${f.toPath().toAbsolutePath().normalize()}: ${token}"
+                    }
+                }
+            }
+        }
+        if (!sourceHits.isEmpty()) {
+            throw new GradleException("removedAiMovePredicateGate SOURCE FAIL:\n  - " + sourceHits.join('\n  - '))
+        }
+
+        def classRoots = [
+                file("${buildDir}/classes/java/main"),
+                file("${buildDir}/classes/java/test"),
+                file("${buildDir}/classes/scala/main"),
+                file("${buildDir}/classes/scala/test")
+        ]
+        def bytecodeHits = [] as List
+        classRoots.each { root ->
+            if (!root.isDirectory()) {
+                return
+            }
+            root.eachFileRecurse(groovy.io.FileType.FILES) { f ->
+                if (!f.name.endsWith('.class')) {
+                    return
+                }
+                def bytes = f.bytes
+                def latin1 = new String(bytes, 'ISO-8859-1')
+                forbidden.each { token ->
+                    if (latin1.contains(token)) {
+                        bytecodeHits << "${f.toPath().toAbsolutePath().normalize()}: ${token}"
+                    }
+                }
+            }
+        }
+        if (!bytecodeHits.isEmpty()) {
+            throw new GradleException("removedAiMovePredicateGate BYTECODE FAIL:\n  - " + bytecodeHits.join('\n  - '))
+        }
+        logger.lifecycle('removedAiMovePredicateGate: PASS (no shouldRunAiMove/shouldRunThrottledAiMove in source or companion bytecode)')
+    }
