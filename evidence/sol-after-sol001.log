    47	                        "Upstream/normal behavior: false (no throttle; movement requests may be issued every tick).",
    48	                        "Optimized default: true. Tradeoff: navigation requests are less frequent and movement response can be less immediate."
    49	                )
    50	                .define("ai_move_throttling_enabled", true);
    51	        AI_MOVE_INTERVAL_TICKS = builder
    52	                .comment(
    53	                        "AI movement-request interval in goal ticks when throttling is enabled.",
    54	                        "Upstream/normal behavior: 1 tick. Optimized default: 4 ticks.",
    55	                        "The first eligible request after a goal starts runs immediately; later due ticks use this interval.",
    56	                        "On a due tick every intended movement/circle call may run; on a skip tick all of them are skipped.",
    57	                        "Tradeoff: larger intervals reduce AI/navigation work but can make following or flight corrections less responsive.",
    58	                        "1 disables cadence optimization for this control."
    59	                )
    60	                .defineInRange("ai_move_interval_ticks", 4, 1, 20);
    61	        EGG_HATCH_CHECK_INTERVAL_TICKS = builder
    62	                .comment(
    63	                        "Server-side egg temperature and hatch-progress check interval in ticks.",
    64	                        "Upstream/normal behavior in Isle of Berk 1.2.0: 20 ticks. Optimized default: 20 ticks.",
    65	                        "Upstream/normal behavior is already 20 ticks; retaining 20 preserves its hatch timing granularity.",
    66	                        "Lower values check more often and can change hatch timing while increasing server work."
    67	                )
    68	                .defineInRange("egg_hatch_check_interval_ticks", 20, 1, 200);
    69	        SHOCK_PARTICLE_INTERVAL_TICKS = builder
    70	                .comment(
    71	                        "Shock-effect particle packet interval in ticks (visual cadence only).",
    72	                        "Upstream/normal behavior in Isle of Berk 1.2.0: 8 ticks. Optimized default: 8 ticks.",
    73	                        "Upstream/normal behavior is already 8 ticks; retaining 8 preserves its visual cadence.",
