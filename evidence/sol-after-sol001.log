# Deterministic common-config reference for the 0.3.1-rc.1 release candidate.
# Forge generates/updates this file from the registered COMMON spec at runtime.
# The comments below intentionally mirror the generated comments and defaults.

[performance]
# Whether repeated AI movement/navigation requests are throttled.
# Upstream/normal behavior: false (no throttle). Optimized default: true.
ai_move_throttling_enabled = true

# Upstream/normal behavior: 1 tick. Optimized default: 4 ticks.
# The first eligible request after a goal starts runs immediately; later eligible requests use this interval.
# 1 disables cadence optimization; larger values reduce navigation work but can reduce responsiveness.
ai_move_interval_ticks = 4

# Upstream/normal behavior in Isle of Berk 1.2.0: 20 ticks. Optimized default: 20 ticks.
# Upstream/normal behavior in Isle of Berk 1.2.0 is already 20 ticks.
# Lower values check more often, change hatch timing granularity, and increase server work.
egg_hatch_check_interval_ticks = 20

# Upstream/normal behavior in Isle of Berk 1.2.0: 8 ticks. Optimized default: 8 ticks.
# Upstream/normal behavior in Isle of Berk 1.2.0 is already 8 ticks.
# Lower values send more packets and make visuals denser. Damage remains fixed at 20 ticks.
shock_particle_interval_ticks = 8

