   122	tasks.register('auditPackagedJar') {
   123	    group = 'verification'
   124	    description = 'Fails if the primary JAR bundles IoB classes/resources or deadlock-fix markers.'
   125	    dependsOn 'canonicalizeReobfJar'
   126	    doLast {
   127	        def libsDir = file("${buildDir}/libs")
   128	        def expectedName = "${archivesBaseName}-${project.version}.jar"
   129	        def primary = file("${libsDir}/${expectedName}")
   130	        if (!primary.isFile()) {
   131	            throw new GradleException("auditPackagedJar: expected primary JAR missing: ${primary}")
   132	        }
   133	        def forbiddenPathPrefixes = [
   134	                'com/GACMD/isleofberk/',
   135	                'network/vonix/isleofberkdeadlockfix/'
   136	        ]
   137	        // Packaged deadlock-fix artifact markers (not prose about the separate optional mod).
   138	        def forbiddenExactResources = [
   139	                'isleofberkdeadlockfix.mixins.json',
   140	                'isleofberkdeadlockfix.refmap.json'
   141	        ] as Set
   142	        def forbiddenClassNameMarkers = [
   143	                'IsleOfBerkDeadlockFix',
   144	                'ADragonBaseMixin',
   145	                'AltFollowGoalMixin'
   146	        ]
   147	        def allowedClassPrefix = 'network/vonix/isleofberkperformance/'
   148	        def allowedNonClass = [
   149	                'pack.mcmeta',
   150	                'isleofberkperformance.mixins.json',
   151	                'isleofberkperformance.refmap.json',
   152	                'META-INF/mods.toml',
   153	                'META-INF/MANIFEST.MF'
   154	        ] as Set
   155	
   156	        def violations = [] as List
   157	        def classEntries = [] as List
   158	        def resourceEntries = [] as List
   159	        java.util.zip.ZipFile zip = new java.util.zip.ZipFile(primary)
   160	        try {
   161	            zip.entries().each { entry ->
   162	                def normalized = entry.name.replace('\\', '/')
   163	                if (normalized.endsWith('/')) {
   164	                    return
   165	                }
   166	                forbiddenPathPrefixes.each { prefix ->
   167	                    if (normalized.startsWith(prefix)) {
   168	                        violations << "forbidden bundled path: ${normalized}"
   169	                    }
   170	                }
   171	                if (forbiddenExactResources.contains(normalized)) {
   172	                    violations << "forbidden deadlock-fix resource: ${normalized}"
   173	                }
   174	                // Any path segment that is the deadlock-fix package/mod id as a resource root.
   175	                if (normalized == 'isleofberkdeadlockfix' || normalized.startsWith('isleofberkdeadlockfix/')) {
   176	                    violations << "forbidden deadlock-fix marker path: ${normalized}"
   177	                }
   178	                if (normalized.endsWith('.class')) {
   179	                    classEntries << normalized
   180	                    if (!normalized.startsWith(allowedClassPrefix)) {
   181	                        violations << "unexpected class outside companion package: ${normalized}"
   182	                    }
   183	                    def simple = normalized.substring(normalized.lastIndexOf('/') + 1).replace('.class', '')
   184	                    forbiddenClassNameMarkers.each { marker ->
   185	                        if (simple == marker || simple.endsWith(marker)) {
   186	                            violations << "forbidden deadlock-fix class marker: ${normalized}"
   187	                        }
   188	                    }
   189	                } else {
   190	                    resourceEntries << normalized
   191	                    if (!allowedNonClass.contains(normalized)) {
   192	                        violations << "unexpected resource outside companion allowlist: ${normalized}"
   193	                    }
   194	                }
   195	            }
   196	        } finally {
   197	            zip.close()
   198	        }
   199	
   200	        if (classEntries.isEmpty()) {
   201	            violations << 'primary JAR contains no companion classes'
   202	        }
   203	        if (!violations.isEmpty()) {
   204	            throw new GradleException("auditPackagedJar FAILED for ${primary.name}:\n  - " + violations.join('\n  - '))
   205	        }
   206	        logger.lifecycle(
   207	                "auditPackagedJar OK: ${primary.name} (${classEntries.size()} classes, ${resourceEntries.size()} resources, companion-only)"
   208	        )
   209	    }
   210	}
