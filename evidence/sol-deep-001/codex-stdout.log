    75	                    "aload_0\naload_1\ninvokevirtual getTextureLocation:(Lnet/minecraft/world/entity/LivingEntity;)Lnet/minecraft/resources/ResourceLocation;\ninvokestatic RenderType.m_110458_:(Lnet/minecraft/resources/ResourceLocation;)Lnet/minecraft/client/renderer/RenderType;\nareturn"),
    76	                    renderer + " exact method body:\n" + normalize(body));
    77	        }
    78	        for (FixedResource resource : FIXED_RESOURCES) {
    79	            String body = methodBody(javap(jar, resource.owner()), resource.method() + "(" + resource.parameter() + ");");
    80	            String normalized = normalizeFixed(body);
    81	            require(normalized.equals("new ResourceLocation isleofberk " + resource.path()),
    82	                    resource.owner() + "#" + resource.method() + " exact method body:\n" + normalized);
    83	        }
    84	        System.out.println("RendererBytecodeFixture: PASS (" + RENDERERS.size() + " renderers, " + FIXED_RESOURCES.size() + " fixed-resource methods)");
    85	    }
    86	
    87	    private static void rejectDragonModelMixins(Path mixinsJson) throws IOException {
    88	        require(Files.isRegularFile(mixinsJson), "companion mixin config missing: " + mixinsJson);
    89	        String json = Files.readString(mixinsJson);
    90	        for (String mixin : FORBIDDEN_DRAGON_MODEL_MIXINS) {
    91	            require(!json.contains('"' + mixin + '"'), "Variant Loader remaps dragon geo/anim; " + mixin + " must not be registered");
    92	        }
    93	    }
    94	
    95	    private static void rejectCancelledVariantLookups(Path mixinDir) throws IOException {
    96	        require(Files.isDirectory(mixinDir), "companion mixin directory missing: " + mixinDir);
    97	        try (var paths = Files.list(mixinDir)) {
    98	            for (Path path : paths.toList()) {
    99	                if (!path.getFileName().toString().endsWith(".java")) {
   100	                    continue;
   101	                }
   102	                String source = Files.readString(path);
   103	                boolean cancelsResource = source.contains("getModelLocation")
   104	                        || source.contains("getAnimationFileLocation")
   105	                        || source.contains("getTextureLocation");
   106	                if (!cancelsResource) {
   107	                    continue;
   108	                }
   109	                require(!source.contains("entity.dragons."),
   110	                        path.getFileName() + " must not cancel dragon geo/anim/texture lookups remapped by Variant Loader");
   111	                require(!source.contains("method = \"getModelLocation") || !source.contains("entity.eggs."),
   112	                        path.getFileName() + " must not cancel egg getModelLocation remapped by Variant Loader");
   113	                require(!source.contains("method = \"getTextureLocation") || !source.contains("entity.eggs."),
   114	                        path.getFileName() + " must not cancel egg getTextureLocation remapped by Variant Loader");
   115	            }
   116	        }
   117	    }
   118	
   119	    private static FixedResource fixed(String owner, String method, String parameter, String path) {
   120	        return new FixedResource(owner, method, parameter, path);
   121	    }
   122	
   123	    private static String javap(Path jar, String className) throws Exception {
   124	        Process process = new ProcessBuilder("javap", "-classpath", jar.toAbsolutePath().toString(), "-p", "-c", className)
   125	                .redirectErrorStream(true).start();
   126	        String output;
   127	        try (InputStream input = process.getInputStream()) {
   128	            output = read(input);
   129	        }
   130	        if (process.waitFor() != 0) {
   131	            throw new IOException("javap failed for " + className + ":\n" + output);
   132	        }
   133	        return output;
   134	    }
   135	
   136	    private static String methodBody(String output, String declarationFragment) {
   137	        int method = output.indexOf(" " + declarationFragment);
   138	        int code = output.indexOf("Code:", method);
   139	        int end = output.indexOf("\n\n", code);
   140	        return method >= 0 && code >= 0 && end >= 0 ? output.substring(method, end) : "";
   141	    }
   142	
   143	    private static String normalize(String body) {
   144	        StringBuilder normalized = new StringBuilder();
   145	        for (String line : body.split("\\R")) {
   146	            String instruction = line.trim().replaceFirst("^\\d+:\\s*", "");
   147	            if (instruction.equals(line.trim())) {
   148	                continue;
   149	            }
   150	            if (instruction.contains("getTextureLocation:")) {
   151	                normalized.append("invokevirtual ").append(instruction.substring(instruction.indexOf("getTextureLocation:"))).append('\n');
   152	            } else if (instruction.contains("RenderType.m_110458_:")) {
   153	                normalized.append("invokestatic ").append(instruction.substring(instruction.indexOf("RenderType.m_110458_:"))).append('\n');
   154	            } else {
   155	                int comment = instruction.indexOf(" //");
   156	                normalized.append(comment >= 0 ? instruction.substring(0, comment) : instruction).append('\n');
   157	            }
   158	        }
   159	        return normalized.toString().strip();
   160	    }
   161	
   162	    private static String normalizeFixed(String body) {
   163	        StringBuilder normalized = new StringBuilder();
   164	        for (String line : body.split("\\R")) {
   165	            String instruction = line.trim().replaceFirst("^\\d+:\\s*", "");
   166	            if (instruction.contains("new") && instruction.contains("ResourceLocation")) {
   167	                normalized.append("new ResourceLocation ");
   168	            } else if (instruction.contains("ldc") && instruction.contains("String isleofberk")) {
   169	                normalized.append("isleofberk ");
   170	            } else if (instruction.contains("ldc") && instruction.contains("String ")) {
   171	                normalized.append(instruction.substring(instruction.indexOf("String ") + 7).strip()).append(' ');
   172	            } else if (instruction.contains("invokespecial") && instruction.contains("ResourceLocation")) {
   173	                normalized.append(' ');
   174	            } else if (instruction.endsWith("areturn")) {
   175	                normalized.append(' ');
   176	            }
   177	        }
   178	        return normalized.toString().strip();
   179	    }
   180	
   181	    private static String read(InputStream input) throws IOException {
   182	        ByteArrayOutputStream output = new ByteArrayOutputStream();
   183	        input.transferTo(output);
   184	        return output.toString(StandardCharsets.UTF_8);
   185	    }
   186	
   187	    private static void require(boolean condition, String message) {
   188	        if (!condition) {
   189	            throw new AssertionError(message);
   190	        }
   191	    }
   192	
   193	    private record FixedResource(String owner, String method, String parameter, String path) {}
   194	}

