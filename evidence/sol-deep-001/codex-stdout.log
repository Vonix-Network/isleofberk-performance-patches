   703	static void assertUtSelectedTimestamps(int flags, int selectedCount, byte[] trailing, String label) {
   704	    byte[] timestamps = fillZipBytes(selectedCount * 4, 0xA0)
   705	    byte[] extra = zipExtraBlock(0x5455, concatZipBytes(zipSingleByte(flags), timestamps, trailing))
   706	    int beforeLen = extra.length
   707	    zeroZipTimestampExtra(extra, 0, extra.length)
   708	    if (extra.length != beforeLen) {
   709	        throw new GradleException("infoZipUxExtraFixture: ${label}: extra-field length changed")
   710	    }
   711	    byte[] after = findZipExtraPayload(extra, extra.length, 0x5455)
   712	    requireZipBytes("${label} flags", sliceZipBytes(after, 0, 1), zipSingleByte(flags))
   713	    requireZipBytes("${label} timestamps", sliceZipBytes(after, 1, 1 + timestamps.length), new byte[timestamps.length])
   714	    if (trailing.length > 0) {
   715	        requireZipBytes("${label} trailing", sliceZipBytes(after, 1 + timestamps.length, after.length), trailing)
   716	    }
   717	}
