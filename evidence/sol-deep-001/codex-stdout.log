     1	package network.vonix.isleofberkperformance.mixin;
     2	
     3	import net.minecraft.world.entity.ai.goal.Goal;
     4	import net.minecraft.world.entity.ai.goal.WrappedGoal;
     5	import network.vonix.isleofberkperformance.internal.AiMoveLifecycle;
     6	import org.spongepowered.asm.mixin.Mixin;
     7	import org.spongepowered.asm.mixin.Shadow;
     8	import org.spongepowered.asm.mixin.injection.At;
     9	import org.spongepowered.asm.mixin.injection.Inject;
    10	import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
    11	
    12	/**
    13	 * Resets patched goals at the actual GoalSelector lifecycle boundary.
    14	 *
    15	 * <p>The pinned 1.18.2 {@code WrappedGoal.start()} and {@code stop()} methods are the
    16	 * transition points used by {@code GoalSelector}; each delegates to its wrapped goal.
    17	 * Injecting here avoids merging inherited lifecycle methods into the IoB target classes.
    18	 */
    19	@Mixin(value = WrappedGoal.class, remap = true)
    20	public abstract class WrappedGoalMixin {
    21	    /**
    22	     * The official mapping boundary for this accessor is getGoal() -> m_26015_.
    23	     * Keeping this shadow remapped lets the compiled dev mixin use getGoal() while
    24	     * the reobfuscated production mixin resolves m_26015_.
    25	     */
    26	    @Shadow
    27	    public abstract Goal getGoal();
    28	
    29	    @Inject(method = "start()V", at = @At("HEAD"), require = 1)
    30	    private void vonix$resetPatchedGoalOnStart(CallbackInfo ci) {
    31	        if (this.getGoal() instanceof AiMoveLifecycle lifecycle) {
    32	            lifecycle.vonix$resetAiMoveTick();
    33	        }
    34	    }
    35	
    36	    @Inject(method = "stop()V", at = @At("HEAD"), require = 1)
    37	    private void vonix$resetPatchedGoalOnStop(CallbackInfo ci) {
    38	        if (this.getGoal() instanceof AiMoveLifecycle lifecycle) {
    39	            lifecycle.vonix$resetAiMoveTick();
    40	        }
    41	    }
    42	}
