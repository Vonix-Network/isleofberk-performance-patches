   689	static void expectGradleFailure(String label, String needle, Closure action) {
   690	    try {
   691	        action.call()
   692	        throw new GradleException("infoZipUxExtraFixture: ${label} did not fail closed")
   693	    } catch (GradleException ex) {
   694	        if (ex.message != null && ex.message.contains('did not fail closed')) {
   695	            throw ex
   696	        }
   697	        if (ex.message == null || !ex.message.contains(needle)) {
   698	            throw new GradleException("infoZipUxExtraFixture: ${label}: unexpected failure: ${ex.message}")
   699	        }
   700	    }
   701	}
