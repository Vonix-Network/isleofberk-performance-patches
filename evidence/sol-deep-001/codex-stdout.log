     3	import net.minecraftforge.common.ForgeConfigSpec;
     4	
     5	/**
     6	 * Common-side controls for cadence changes that intentionally affect gameplay or visual timing.
     7	 * Forge owns loading/reloading the values from config/isleofberkperformance.toml.
     8	 *
     9	 * <p>AI movement-request phase: the first eligible gated request after a goal lifecycle
    10	 * reset runs immediately; later eligible requests run every {@code ai_move_interval_ticks}.
    11	 * That matches upstream "request now" at activation, then applies the configured interval.
    12	 * Interval {@code 1} or {@code ai_move_throttling_enabled=false} keeps every eligible request.
    13	 */
    14	public final class PerformanceConfig {
    15	    public static final ForgeConfigSpec SPEC;
    16	
    17	    public static final ForgeConfigSpec.BooleanValue AI_MOVE_THROTTLING_ENABLED;
    18	    public static final ForgeConfigSpec.IntValue AI_MOVE_INTERVAL_TICKS;
    19	    public static final ForgeConfigSpec.IntValue EGG_HATCH_CHECK_INTERVAL_TICKS;
    20	    public static final ForgeConfigSpec.IntValue SHOCK_PARTICLE_INTERVAL_TICKS;
    21	
    22	    static {
    23	        ForgeConfigSpec.Builder builder = new ForgeConfigSpec.Builder();
    24	        builder.comment(
    25	                "Isle of Berk Performance Patches common configuration.",
    26	                "These controls intentionally change gameplay timing or visual cadence.",
    27	                "For AI movement, set an interval to 1 to disable that cadence optimization and use every eligible request.",
    28	                "When throttling is enabled, the first eligible request after a goal starts runs immediately, then every configured interval.",
    29	                "Damage cadence is not configurable and remains fixed at 20 ticks."
    30	        );
    31	        builder.push("performance");
    32	
    33	        AI_MOVE_THROTTLING_ENABLED = builder
    34	                .comment(
    35	                        "Whether repeated AI navigation movement requests are throttled.",
    36	                        "Upstream/normal behavior: false (no throttle; movement requests may be issued every tick).",
    37	                        "Optimized default: true. Tradeoff: navigation requests are less frequent and movement response can be less immediate."
    38	                )
    39	                .define("ai_move_throttling_enabled", true);
    40	        AI_MOVE_INTERVAL_TICKS = builder
    41	                .comment(
    42	                        "AI movement-request interval in ticks when throttling is enabled.",
    43	                        "Upstream/normal behavior: 1 tick. Optimized default: 4 ticks.",
    44	                        "The first eligible request after a goal starts runs immediately; later eligible requests use this interval.",
    45	                        "Tradeoff: larger intervals reduce AI/navigation work but can make following or flight corrections less responsive.",
    46	                        "1 disables cadence optimization for this control."
    47	                )
    48	                .defineInRange("ai_move_interval_ticks", 4, 1, 20);
    49	        EGG_HATCH_CHECK_INTERVAL_TICKS = builder
    50	                .comment(
    51	                        "Server-side egg temperature and hatch-progress check interval in ticks.",
    52	                        "Upstream/normal behavior in Isle of Berk 1.2.0: 20 ticks. Optimized default: 20 ticks.",
    53	                        "Upstream/normal behavior is already 20 ticks; retaining 20 preserves its hatch timing granularity.",
    54	                        "Lower values check more often and can change hatch timing while increasing server work."
    55	                )
    56	                .defineInRange("egg_hatch_check_interval_ticks", 20, 1, 200);
    57	        SHOCK_PARTICLE_INTERVAL_TICKS = builder
    58	                .comment(
    59	                        "Shock-effect particle packet interval in ticks (visual cadence only).",
    60	                        "Upstream/normal behavior in Isle of Berk 1.2.0: 8 ticks. Optimized default: 8 ticks.",
    61	                        "Upstream/normal behavior is already 8 ticks; retaining 8 preserves its visual cadence.",
    62	                        "Lower values send more packets and make shock visuals denser at higher network/client cost.",
    63	                        "Damage remains fixed at the upstream 20-tick cadence and is not changed by this key."
    64	                )
    65	                .defineInRange("shock_particle_interval_ticks", 8, 1, 200);
    66	        builder.pop();
    67	
    68	        SPEC = builder.build();
    69	    }
    70	
    71	    private PerformanceConfig() {}
    72	
    73	    /**
    74	     * @return true when throttling is disabled or the interval is 1 (every eligible request).
    75	     */
    76	    public static boolean shouldRunAiMove() {
    77	        return !AI_MOVE_THROTTLING_ENABLED.get() || AI_MOVE_INTERVAL_TICKS.get() <= 1;
    78	    }
    79	
    80	    /**
    81	     * Whether one gated movement/circle request should run.
    82	     *
    83	     * @param moveTick 1-based count of gated request sites since the last goal start/stop reset
    84	     * @return true for the first request after reset, then every configured interval
    85	     */
    86	    public static boolean shouldRunAiMove(int moveTick) {
    87	        return shouldRunAiMove() || shouldRunThrottledAiMove(moveTick, AI_MOVE_INTERVAL_TICKS.get());
    88	    }
    89	
    90	    /**
    91	     * Pure interval predicate used by {@link #shouldRunAiMove(int)}.
    92	     * {@code moveTick} is 1-based; tick 1 always runs, then ticks {@code 1 + n * interval}.
    93	     */
    94	    public static boolean shouldRunThrottledAiMove(int moveTick, int interval) {
    95	        return moveTick > 0 && interval > 0 && (moveTick - 1) % interval == 0;
    96	    }
    97	}
