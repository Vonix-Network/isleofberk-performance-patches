   473	    }
   474	
   475	    def before = [] as List
   476	    // DOS 1980-02-01 00:00:00; same fixed date Gradle uses for reproducible JARs.
   477	    int dosTime = 0
   478	    int dosDate = (0 << 9) | (2 << 5) | 1
