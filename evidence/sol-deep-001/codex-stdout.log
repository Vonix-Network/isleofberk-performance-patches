     9	import org.spongepowered.asm.mixin.Unique;
    10	import org.spongepowered.asm.mixin.injection.At;
    11	import org.spongepowered.asm.mixin.injection.Redirect;
    12	
    13	/**
    14	 * Narrow gate for circle movement; random choice and circle state remain in the original method.
    15	 *
    16	 * <p>The counter is reset by {@link WrappedGoalMixin} at the actual wrapped-goal start/stop
    17	 * transition. {@code canUse()} is not a reset point: vanilla {@code Goal.canContinueToUse()}
    18	 * delegates to {@code canUse()} on every running tick and would zero the counter before each
    19	 * {@code tick()}.
    20	 *
    21	 * <p>Pinned {@code tick()} contains exactly two mutually exclusive
    22	 * {@code ADragonBaseFlyingRideable.circleEntity} invokes.
    23	 */
    24	@Mixin(value = UntamedDragonCircleFlightGoal.class, remap = true)
    25	public abstract class UntamedDragonCircleFlightGoalMixin implements AiMoveLifecycle {
    26	    @Unique private int vonix$moveTick;
    27	
    28	    @Override
    29	    public void vonix$resetAiMoveTick() {
    30	        this.vonix$moveTick = 0;
    31	    }
    32	
    33	    @Redirect(
    34	            method = "tick()V",
    35	            at = @At(
    36	                    value = "INVOKE",
    37	                    target = "Lcom/GACMD/isleofberk/entity/base/dragon/ADragonBaseFlyingRideable;circleEntity(Lnet/minecraft/world/phys/Vec3;FFZIFF)V",
    38	                    remap = false
    39	            ),
    40	            require = 2,
    41	            expect = 2,
    42	            allow = 2
    43	    )
    44	    private void vonix$gateCircleRequest(
    45	            ADragonBaseFlyingRideable dragon,
    46	            Vec3 center,
    47	            float radius,
    48	            float speed,
    49	            boolean clockwise,
    50	            int tick,
    51	            float xScale,
    52	            float zScale
    53	    ) {
    54	        if (PerformanceConfig.shouldRunAiMove(++this.vonix$moveTick)) {
    55	            dragon.circleEntity(center, radius, speed, clockwise, tick, xScale, zScale);
    56	        }
    57	    }
    58	}
