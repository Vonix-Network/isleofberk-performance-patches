   943	static String extractSpecDefault(String spec, String defineCall, String fallback) {
   944	    def matcher = (spec =~ /(?s)${java.util.regex.Pattern.quote(defineCall)},\s*(true|false)\s*\)/)
   945	    if (!matcher.find()) {
