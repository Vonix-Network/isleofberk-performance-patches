   143	    private static String normalize(String body) {
   144	        StringBuilder normalized = new StringBuilder();
   145	        for (String line : body.split("\\R")) {
   146	            String instruction = line.trim().replaceFirst("^\\d+:\\s*", "");
   147	            if (instruction.equals(line.trim())) {
   148	                continue;
   149	            }
   150	            if (instruction.contains("getTextureLocation:")) {
   151	                normalized.append("invokevirtual ").append(instruction.substring(instruction.indexOf("getTextureLocation:"))).append('\n');
   152	            } else if (instruction.contains("RenderType.m_110458_:")) {
   153	                normalized.append("invokestatic ").append(instruction.substring(instruction.indexOf("RenderType.m_110458_:"))).append('\n');
   154	            } else {
   155	                int comment = instruction.indexOf(" //");
   156	                normalized.append(comment >= 0 ? instruction.substring(0, comment) : instruction).append('\n');
   157	            }
   158	        }
   159	        return normalized.toString().strip();
   160	    }
   161	
   162	    private static String normalizeFixed(String body) {
   163	        StringBuilder normalized = new StringBuilder();
   164	        for (String line : body.split("\\R")) {
   165	            String instruction = line.trim().replaceFirst("^\\d+:\\s*", "");
   166	            if (instruction.contains("new") && instruction.contains("ResourceLocation")) {
   167	                normalized.append("new ResourceLocation ");
   168	            } else if (instruction.contains("ldc") && instruction.contains("String isleofberk")) {
   169	                normalized.append("isleofberk ");
   170	            } else if (instruction.contains("ldc") && instruction.contains("String ")) {
   171	                normalized.append(instruction.substring(instruction.indexOf("String ") + 7).strip()).append(' ');
   172	            } else if (instruction.contains("invokespecial") && instruction.contains("ResourceLocation")) {
   173	                normalized.append(' ');
   174	            } else if (instruction.endsWith("areturn")) {
   175	                normalized.append(' ');
   176	            }
   177	        }
   178	        return normalized.toString().strip();
   179	    }
